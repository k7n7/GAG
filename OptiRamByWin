-- ============================================================================
--  TRUNGPHANHUB GAG2 OPTI STANDALONE V5 - GUI + NO RENDER SAFE TEST
--
--  Dùng riêng, không gộp farm script.
--  Mục tiêu: dùng chung với DuckHub/farm script khác mà ít ảnh hưởng nhất.
--
--  V5 thêm:
--  - Console log rõ ràng: [OK] [WARN] [SKIP] [ACTION] [STATS]
--  - GUI Optimizer: chỉ disable GUI không cần thiết, KHÔNG destroy.
--  - Viewport Optimizer: dọn preview 3D trong GUI không cần thiết.
--  - Optional NoRenderMode: tắt render 3D mạnh tay.
--
--  Mặc định:
--  - NoRenderMode = false để test an toàn.
--  - Muốn mạnh nhất thì đổi NoRenderMode = true.
--
--  Rule an toàn:
--  - My Plot = không đụng
--  - Pets = không đụng
--  - Shop/NPCS = không đụng trong Workspace
--  - Weather = chỉ tắt hiệu ứng
--  - Other Plot = xóa
--  - Other Character = ẩn
--  - GUI = disable, không destroy
-- ============================================================================

task.wait(2)

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Stats = game:GetService("Stats")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

local CONFIG = {
    FPSCap = 8,

    -- Mạnh nhất nhưng cần test với DuckHub.
    NoRenderMode = false,

    DestroyOtherPlots = true,
    HideOtherCharacters = true,

    DisablePostFX = true,
    DisableWeatherEffects = true,

    -- GUI optimizer
    OptimizeGUI = true,
    DisableUnusedGUI = true,
    DisableViewportFrames = true,

    -- Giữ lại các GUI có thể script farm/mail/weather cần.
    KeepGUI = {
        ["BackpackGui"] = true,
        ["SeedShop"] = true,
        ["GearShop"] = true,
        ["MailboxUI"] = true,
        ["WeatherUI"] = true,
        ["HUD"] = true,
        ["TopbarStandard"] = true,
        ["TopbarStandardClipped"] = true,
        ["TopbarCentered"] = true,
        ["TopbarCenteredClipped"] = true,
        ["Tooltip"] = true,
        ["PlantHoverTooltip"] = true,
        ["PetHoverTooltip"] = true,
        ["Cmdr"] = true,
    },

    LightRecleanEverySeconds = 20,
    GCEverySeconds = 30,
    PrintStatsEverySeconds = 60,

    Debug = true,
}

local processed = setmetatable({}, {__mode = "k"})

local function log(level, ...)
    print("[GAG2 OPTI V5][" .. level .. "]", ...)
end

local function safe(fn)
    local ok, result = pcall(fn)
    return ok, result
end

local function setFPS()
    pcall(function()
        if type(setfpscap) == "function" and CONFIG.FPSCap and CONFIG.FPSCap > 0 then
            setfpscap(CONFIG.FPSCap)
            log("OK", "FPS cap set", CONFIG.FPSCap)
        else
            log("SKIP", "setfpscap not available")
        end
    end)
end

local function setNoRender()
    if not CONFIG.NoRenderMode then
        log("SKIP", "NoRenderMode=false")
        return
    end

    local ok, err = pcall(function()
        RunService:Set3dRenderingEnabled(false)
    end)

    if ok then
        log("OK", "3D rendering disabled")
    else
        log("WARN", "failed to disable 3D rendering", err)
    end
end

local function totalMemMb()
    local ok, v = pcall(function()
        return Stats:GetTotalMemoryUsageMb()
    end)
    return ok and v or -1
end

local function countDesc(root)
    if not root then return 0 end
    local ok, n = pcall(function()
        return #root:GetDescendants()
    end)
    return ok and n or 0
end

local function countClass(root, className)
    if not root then return 0 end
    local n = 0
    local ok, desc = pcall(function()
        return root:GetDescendants()
    end)
    if not ok then return 0 end
    for _, obj in ipairs(desc) do
        if obj:IsA(className) then n += 1 end
    end
    return n
end

local function printStats(label)
    local gardens = workspace:FindFirstChild("Gardens")
    local pg = Player:FindFirstChild("PlayerGui")

    log("STATS", label,
        "memMB", string.format("%.1f", totalMemMb()),
        "workspaceDesc", countDesc(workspace),
        "gardenDesc", countDesc(gardens),
        "playerGuiDesc", countDesc(pg),
        "guiCount", pg and #pg:GetChildren() or 0,
        "viewportFrames", countClass(pg, "ViewportFrame"),
        "parts", countClass(workspace, "BasePart"),
        "particles", countClass(workspace, "ParticleEmitter"),
        "prompts", countClass(workspace, "ProximityPrompt")
    )
end

local function getMyPlot()
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return nil end

    local ok, plot = pcall(function()
        local controllers = Player:WaitForChild("PlayerScripts"):WaitForChild("Controllers")
        local plantController = require(controllers:WaitForChild("PlantController"))
        return plantController:GetPlayerPlot()
    end)

    if ok and plot and plot.Parent == gardens then
        return plot
    end

    for _, plotCandidate in ipairs(gardens:GetChildren()) do
        for _, v in pairs(plotCandidate:GetAttributes()) do
            local text = tostring(v)
            if text == Player.Name or text == tostring(Player.UserId) then
                return plotCandidate
            end
        end
    end

    return nil
end

local function destroyOtherPlot(plot)
    if not plot or not plot.Parent then return false end
    local path = plot:GetFullName()

    local ok, err = pcall(function()
        plot:Destroy()
    end)

    if ok then
        log("ACTION", "Destroy other plot", path)
        return true
    else
        log("WARN", "Destroy other plot failed", path, err)
        return false
    end
end

local function cleanOtherPlotsOnce()
    if not CONFIG.DestroyOtherPlots then
        log("SKIP", "DestroyOtherPlots=false")
        return 0
    end

    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then
        log("WARN", "Gardens not found")
        return 0
    end

    local myPlot = getMyPlot()
    if not myPlot then
        log("WARN", "My plot not found, skip other plot clean")
        return 0
    end

    local removed = 0
    for _, plot in ipairs(gardens:GetChildren()) do
        if plot ~= myPlot then
            if destroyOtherPlot(plot) then
                removed += 1
            end
        end
    end

    log("OK", "My plot kept", myPlot:GetFullName())
    log("OK", "Other plots removed", removed)

    return removed
end

local function hideCharacter(char)
    if not char or processed[char] then return end
    processed[char] = true

    local touched = 0

    for _, obj in ipairs(char:GetDescendants()) do
        pcall(function()
            if obj:IsA("BasePart") then
                obj.CastShadow = false
                obj.CanCollide = false
                obj.CanTouch = false
                obj.CanQuery = false
                obj.LocalTransparencyModifier = 1
                touched += 1
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
                touched += 1
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = false
                touched += 1
            elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                obj.Enabled = false
                touched += 1
            elseif obj:IsA("Sound") then
                obj.Volume = 0
                obj:Stop()
                touched += 1
            end
        end)
    end

    log("ACTION", "Hide character", char.Name, "objects", touched)
end

local function hideOtherCharactersOnce()
    if not CONFIG.HideOtherCharacters then return 0 end

    local hidden = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player and plr.Character then
            hideCharacter(plr.Character)
            hidden += 1
        end
    end

    log("OK", "Other characters checked", hidden)
    return hidden
end

local function applyPostFX()
    if not CONFIG.DisablePostFX then
        log("SKIP", "DisablePostFX=false")
        return
    end

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    local changed = 0
    for _, obj in ipairs(Lighting:GetDescendants()) do
        pcall(function()
            if obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("DepthOfFieldEffect")
                or obj:IsA("SunRaysEffect") or obj:IsA("ColorCorrectionEffect") then
                obj.Enabled = false
                changed += 1
            elseif obj:IsA("Atmosphere") then
                obj.Density = 0
                obj.Haze = 0
                obj.Glare = 0
                changed += 1
            end
        end)
    end

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.Brightness = 1
    end)

    log("OK", "PostFX optimized", changed)
end

local function isWeatherOrEffectRoot(obj)
    if not obj then return false end
    local n = obj.Name:lower()
    return n == "weather"
        or n == "effects"
        or n == "vfx"
        or n == "_vfx"
        or n == "visuals"
        or n == "particles"
        or n == "weatherfx"
        or n == "weather_effects"
end

local function disableEffectTree(root)
    if not root then return 0 end

    local n = 0
    for _, obj in ipairs(root:GetDescendants()) do
        pcall(function()
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = false
                n += 1
            elseif obj:IsA("Sound") then
                obj.Volume = 0
                obj:Stop()
                n += 1
            elseif obj:IsA("BasePart") then
                obj.CastShadow = false
                n += 1
            end
        end)

        if n % 500 == 0 then task.wait() end
    end

    return n
end

local function disableExistingWeatherEffects()
    if not CONFIG.DisableWeatherEffects then return 0 end

    local n = 0
    for _, child in ipairs(workspace:GetChildren()) do
        if isWeatherOrEffectRoot(child) then
            n += disableEffectTree(child)
        end
    end

    log("OK", "Weather/effect optimized", n)
    return n
end

local function optimizeGUI()
    if not CONFIG.OptimizeGUI then
        log("SKIP", "OptimizeGUI=false")
        return 0, 0
    end

    local pg = Player:FindFirstChild("PlayerGui")
    if not pg then
        log("WARN", "PlayerGui not found")
        return 0, 0
    end

    local disabledGui = 0
    local cleanedViewport = 0

    if CONFIG.DisableUnusedGUI then
        for _, gui in ipairs(pg:GetChildren()) do
            if gui:IsA("ScreenGui") and not CONFIG.KeepGUI[gui.Name] then
                pcall(function()
                    if gui.Enabled then
                        gui.Enabled = false
                        disabledGui += 1
                        log("ACTION", "GUI disabled", gui.Name)
                    end
                end)
            end
        end
    end

    if CONFIG.DisableViewportFrames then
        for _, vp in ipairs(pg:GetDescendants()) do
            if vp:IsA("ViewportFrame") then
                -- Không destroy ViewportFrame, chỉ xóa preview model bên trong.
                for _, child in ipairs(vp:GetChildren()) do
                    if child:IsA("Model") or child:IsA("BasePart") or child:IsA("Camera") or child:IsA("WorldModel") then
                        pcall(function()
                            child:Destroy()
                            cleanedViewport += 1
                        end)
                    end
                end
            end
        end

        if cleanedViewport > 0 then
            log("ACTION", "Viewport preview objects removed", cleanedViewport)
        else
            log("OK", "Viewport preview clean, none removed")
        end
    end

    log("OK", "GUI optimized", "disabledGui", disabledGui, "viewportObjects", cleanedViewport)
    return disabledGui, cleanedViewport
end

local function applyOnce()
    setFPS()
    setNoRender()
    applyPostFX()

    local p = cleanOtherPlotsOnce()
    local c = hideOtherCharactersOnce()
    local w = disableExistingWeatherEffects()
    local g, v = optimizeGUI()

    pcall(function()
        collectgarbage("collect")
    end)

    log("OK", "Cycle complete",
        "plots", p,
        "chars", c,
        "weather", w,
        "disabledGui", g,
        "viewportClean", v
    )
end

local function hookPlayer(plr)
    if plr == Player then return end

    if plr.Character then
        task.defer(function()
            task.wait(0.5)
            hideCharacter(plr.Character)
        end)
    end

    plr.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        hideCharacter(char)
        log("ACTION", "CharacterAdded hidden", plr.Name)
    end)
end

print("===== TRUNGPHANHUB GAG2 OPTI STANDALONE V5 START =====")
log("OK", "DuckHub compatibility mode: no remotes touched, my plot kept")
printStats("BEFORE")

applyOnce()

task.wait(3)
printStats("AFTER_FIRST")
print("===== TRUNGPHANHUB GAG2 OPTI STANDALONE V5 APPLIED =====")

for _, plr in ipairs(Players:GetPlayers()) do
    hookPlayer(plr)
end

Players.PlayerAdded:Connect(function(plr)
    log("ACTION", "PlayerAdded detected", plr.Name)
    hookPlayer(plr)
end)

task.spawn(function()
    local gardens = workspace:WaitForChild("Gardens", 60)
    if gardens then
        gardens.ChildAdded:Connect(function(plot)
            task.wait(0.5)
            local myPlot = getMyPlot()
            if myPlot and plot ~= myPlot and CONFIG.DestroyOtherPlots then
                destroyOtherPlot(plot)
                log("ACTION", "PlotAdded cleaned", plot.Name)
            else
                log("SKIP", "PlotAdded kept", plot.Name)
            end
        end)
    end
end)

workspace.ChildAdded:Connect(function(obj)
    task.defer(function()
        task.wait(0.2)
        if isWeatherOrEffectRoot(obj) then
            local n = disableEffectTree(obj)
            log("ACTION", "Effect root cleaned", obj:GetFullName(), n)
        end
    end)
end)

task.spawn(function()
    while task.wait(CONFIG.LightRecleanEverySeconds) do
        applyOnce()
    end
end)

task.spawn(function()
    while task.wait(CONFIG.GCEverySeconds) do
        pcall(function()
            collectgarbage("collect")
        end)
        log("OK", "Lua GC collect")
    end
end)

task.spawn(function()
    while task.wait(CONFIG.PrintStatsEverySeconds) do
        printStats("PERIODIC")
    end
end)
