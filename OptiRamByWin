-- ============================================================================
--  TRUNGPHANHUB GAG2 OPTI STANDALONE V3 - EVENT DRIVEN
--
--  Script OPTI riêng biệt, KHÔNG gộp farm script.
--
--  Mục tiêu V3:
--  - Bỏ SoftLimit / HardLimit / AutoRejoin.
--  - Không "lock RAM" giả.
--  - Tối ưu dạng detect/event-driven:
--      + Plot người khác xuất hiện -> xóa ngay.
--      + Player/character người khác xuất hiện -> ẩn ngay.
--      + Effect mới xuất hiện -> disable ngay.
--  - Giảm scan toàn workspace lặp lại để ít ảnh hưởng farm.
--
--  Giữ an toàn:
--  - Không xóa plot của bạn.
--  - Không xóa ReplicatedStorage.Assets.Plants.
--  - Không disable GUI hàng loạt.
--  - Không destroy character người khác.
--  - Không đụng NPCS, shop, pet, weather/event seed, dropped item, remote.
--
--  Nếu lỗi: rejoin server là khôi phục.
-- ============================================================================

task.wait(2)

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Stats = game:GetService("Stats")

local Player = Players.LocalPlayer

local CONFIG = {
    FPSCap = 8,

    DestroyOtherPlots = true,
    HideOtherCharacters = true,

    DisablePostFX = true,
    DisableWeatherEffects = true,
    DisableParticlesGlobal = true,
    DisableSounds = true,
    DisableShadows = true,

    -- Scan đầu tiên để dọn object đã tồn tại.
    InitialClean = true,

    -- Sau initial clean, chủ yếu dùng event detect.
    -- Reclean chỉ để chống miss khi game load chậm.
    LightRecleanEverySeconds = 20,

    GCEverySeconds = 30,
    PrintStatsEverySeconds = 60,

    Debug = true,
}

local processed = setmetatable({}, {__mode = "k"})

local function log(...)
    if CONFIG.Debug then
        print("[GAG2 OPTI V3]", ...)
    end
end

local function setFPS()
    pcall(function()
        if type(setfpscap) == "function" and CONFIG.FPSCap and CONFIG.FPSCap > 0 then
            setfpscap(CONFIG.FPSCap)
        end
    end)
end

local function totalMemMb()
    local ok, v = pcall(function()
        return Stats:GetTotalMemoryUsageMb()
    end)
    return ok and v or -1
end

local function countDesc(root)
    if not root then return 0 end
    local ok, n = pcall(function()
        return #root:GetDescendants()
    end)
    return ok and n or 0
end

local function countClass(root, className)
    if not root then return 0 end
    local n = 0
    local ok, desc = pcall(function()
        return root:GetDescendants()
    end)
    if not ok then return 0 end

    for _, obj in ipairs(desc) do
        if obj:IsA(className) then
            n += 1
        end
    end
    return n
end

local function printStats(label)
    local gardens = workspace:FindFirstChild("Gardens")
    print("[GAG2 OPTI V3 STATS]", label,
        "memMB", string.format("%.1f", totalMemMb()),
        "workspaceDesc", countDesc(workspace),
        "gardenDesc", countDesc(gardens),
        "parts", countClass(workspace, "BasePart"),
        "particles", countClass(workspace, "ParticleEmitter"),
        "prompts", countClass(workspace, "ProximityPrompt")
    )
end

local function getMyPlot()
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return nil end

    local ok, plot = pcall(function()
        local controllers = Player:WaitForChild("PlayerScripts"):WaitForChild("Controllers")
        local plantController = require(controllers:WaitForChild("PlantController"))
        return plantController:GetPlayerPlot()
    end)
    if ok and plot and plot.Parent == gardens then
        return plot
    end

    for _, plotCandidate in ipairs(gardens:GetChildren()) do
        for _, v in pairs(plotCandidate:GetAttributes()) do
            local text = tostring(v)
            if text == Player.Name or text == tostring(Player.UserId) then
                return plotCandidate
            end
        end
    end

    for _, plotCandidate in ipairs(gardens:GetChildren()) do
        local sign = plotCandidate:FindFirstChild("Sign", true)
        if sign then
            for _, obj in ipairs(sign:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    if tostring(obj.Text or ""):find(Player.Name, 1, true) then
                        return plotCandidate
                    end
                end
            end
        end
    end

    return nil
end

local function destroySafe(obj, reason)
    if not obj or not obj.Parent then return false end

    local path = obj:GetFullName()
    local ok, err = pcall(function()
        obj:Destroy()
    end)

    if ok then
        log("DESTROY", reason, path)
        return true
    else
        warn("[GAG2 OPTI V3 DESTROY FAIL]", reason, path, err)
        return false
    end
end

local function optimizeInstance(obj, hide)
    if not obj or processed[obj] then return end
    processed[obj] = true

    pcall(function()
        if obj:IsA("BasePart") then
            if CONFIG.DisableShadows then
                obj.CastShadow = false
            end

            obj.CanTouch = false
            obj.CanQuery = false

            if hide then
                obj.CanCollide = false
                obj.LocalTransparencyModifier = 1
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            if hide then
                obj.Transparency = 1
            end
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            obj.Enabled = false
        elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            if hide then
                obj.Enabled = false
            end
        elseif obj:IsA("Sound") and CONFIG.DisableSounds then
            obj.Volume = 0
            obj:Stop()
        end
    end)
end

local function optimizeTree(root, hide, slice)
    if not root then return 0 end

    local count = 0
    local ok, desc = pcall(function()
        return root:GetDescendants()
    end)
    if not ok then return 0 end

    for i, obj in ipairs(desc) do
        optimizeInstance(obj, hide)
        count += 1

        if slice and i % 500 == 0 then
            task.wait()
        end
    end

    return count
end

local function applyPostFX()
    setFPS()

    if not CONFIG.DisablePostFX then return end

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    for _, obj in ipairs(Lighting:GetDescendants()) do
        pcall(function()
            if obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("DepthOfFieldEffect")
                or obj:IsA("SunRaysEffect") or obj:IsA("ColorCorrectionEffect") then
                obj.Enabled = false
            elseif obj:IsA("Atmosphere") then
                obj.Density = 0
                obj.Haze = 0
                obj.Glare = 0
            end
        end)
    end

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.Brightness = 1
    end)
end

local function cleanOtherPlotsOnce()
    if not CONFIG.DestroyOtherPlots then return 0 end

    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return 0 end

    local myPlot = getMyPlot()
    if not myPlot then
        warn("[GAG2 OPTI V3] My plot not found; skip plot clean")
        return 0
    end

    local removed = 0

    for _, plot in ipairs(gardens:GetChildren()) do
        if plot ~= myPlot then
            if destroySafe(plot, "OTHER_PLOT") then
                removed += 1
            end
        end
    end

    if removed > 0 then
        print("[GAG2 OPTI V3 MY PLOT]", myPlot:GetFullName())
        print("[GAG2 OPTI V3 PLOTS REMOVED]", removed)
    end

    return removed
end

local function hideCharacter(char)
    if not char then return end
    optimizeTree(char, true, false)
end

local function hideOtherCharactersOnce()
    if not CONFIG.HideOtherCharacters then return 0 end

    local hidden = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player and plr.Character then
            hideCharacter(plr.Character)
            hidden += 1
        end
    end

    return hidden
end

local function isEffectRoot(obj)
    if not obj then return false end
    local n = obj.Name:lower()
    return n == "weather"
        or n == "effects"
        or n == "vfx"
        or n == "_vfx"
        or n == "visuals"
        or n == "particles"
end

local function disableExistingEffects()
    local disabled = 0

    for _, root in ipairs(workspace:GetChildren()) do
        if isEffectRoot(root) then
            disabled += optimizeTree(root, false, true)
        end
    end

    -- Initial pass: chỉ disable particle/sound/shadow, không hide map.
    if CONFIG.DisableParticlesGlobal or CONFIG.DisableShadows or CONFIG.DisableSounds then
        local ok, desc = pcall(function()
            return workspace:GetDescendants()
        end)

        if ok then
            for i, obj in ipairs(desc) do
                pcall(function()
                    if obj:IsA("BasePart") and CONFIG.DisableShadows then
                        obj.CastShadow = false
                    elseif CONFIG.DisableParticlesGlobal and (
                        obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
                    ) then
                        obj.Enabled = false
                    elseif CONFIG.DisableSounds and obj:IsA("Sound") then
                        obj.Volume = 0
                        obj:Stop()
                    end
                end)

                if i % 1000 == 0 then
                    task.wait()
                end
            end
        end
    end

    return disabled
end

local function handleWorkspaceAdded(obj)
    task.defer(function()
        if not obj or not obj.Parent then return end

        local gardens = workspace:FindFirstChild("Gardens")
        local myPlot = getMyPlot()

        -- Plot mới replicate: nếu không phải mình thì xóa ngay.
        if gardens and obj.Parent == gardens and obj ~= myPlot and CONFIG.DestroyOtherPlots then
            task.wait(0.5)
            myPlot = getMyPlot()
            if myPlot and obj ~= myPlot and obj.Parent == gardens then
                destroySafe(obj, "OTHER_PLOT_ADDED")
            end
            return
        end

        -- Character người khác spawn: chỉ ẩn.
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player and obj == plr.Character then
                task.wait(0.5)
                hideCharacter(obj)
                print("[GAG2 OPTI V3 CHAR DETECT HIDDEN]", plr.Name)
                return
            end
        end

        -- Effect mới xuất hiện: disable.
        if isEffectRoot(obj) then
            task.wait(0.2)
            optimizeTree(obj, false, true)
            print("[GAG2 OPTI V3 EFFECT ROOT CLEANED]", obj:GetFullName())
            return
        end

        -- Particle/sound/basepart mới: xử lý đúng object đó, không scan cả workspace.
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
            or obj:IsA("Sound") or obj:IsA("BasePart") then
            optimizeInstance(obj, false)
        end
    end)
end

local function initialClean()
    applyPostFX()

    local removedPlots = cleanOtherPlotsOnce()
    local hiddenChars = hideOtherCharactersOnce()
    local effects = disableExistingEffects()

    pcall(function()
        collectgarbage("collect")
    end)

    print("[GAG2 OPTI V3 INITIAL RESULT]",
        "removedPlots", removedPlots,
        "hiddenChars", hiddenChars,
        "effectPass", effects
    )
end

print("===== TRUNGPHANHUB GAG2 OPTI STANDALONE V3 EVENT DRIVEN START =====")
printStats("BEFORE")

if CONFIG.InitialClean then
    initialClean()
end

task.wait(3)
printStats("AFTER_FIRST")
print("===== TRUNGPHANHUB GAG2 OPTI STANDALONE V3 APPLIED =====")

-- Event-driven: object mới xuất hiện thì xử lý ngay.
workspace.ChildAdded:Connect(handleWorkspaceAdded)
workspace.DescendantAdded:Connect(function(obj)
    -- Chỉ xử lý class nhẹ; không gọi getMyPlot ở đây để tránh nặng.
    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
        or obj:IsA("Sound") or obj:IsA("BasePart") then
        optimizeInstance(obj, false)
    end
end)

-- Hook player mới.
local function hookPlayer(plr)
    if plr == Player then return end

    if plr.Character then
        task.defer(function()
            task.wait(0.5)
            hideCharacter(plr.Character)
        end)
    end

    plr.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        hideCharacter(char)
        print("[GAG2 OPTI V3 CHAR ADDED HIDDEN]", plr.Name)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    hookPlayer(plr)
end

Players.PlayerAdded:Connect(function(plr)
    print("[GAG2 OPTI V3 PLAYER ADDED]", plr.Name)
    hookPlayer(plr)
end)

-- Garden ChildAdded riêng: chính xác hơn workspace.ChildAdded.
task.spawn(function()
    local gardens = workspace:WaitForChild("Gardens", 60)
    if gardens then
        gardens.ChildAdded:Connect(function(plot)
            task.wait(0.5)
            local myPlot = getMyPlot()
            if myPlot and plot ~= myPlot and CONFIG.DestroyOtherPlots then
                destroySafe(plot, "OTHER_PLOT_DETECT")
                print("[GAG2 OPTI V3 PLOT DETECT CLEANED]", plot.Name)
            end
        end)
    end
end)

-- Reclean nhẹ, không còn watchdog RAM.
task.spawn(function()
    while task.wait(CONFIG.LightRecleanEverySeconds) do
        applyPostFX()
        cleanOtherPlotsOnce()
        hideOtherCharactersOnce()
    end
end)

task.spawn(function()
    while task.wait(CONFIG.GCEverySeconds) do
        pcall(function()
            collectgarbage("collect")
        end)
    end
end)

task.spawn(function()
    while task.wait(CONFIG.PrintStatsEverySeconds) do
        printStats("PERIODIC")
    end
end)
