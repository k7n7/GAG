local ReplicaController
local LocalReplica

local function GetLocalReplica()
    if LocalReplica then
        return LocalReplica
    end

    local PlotsController = require(Controllers:WaitForChild("PlotsController"))

    for _, up in ipairs(debug.getupvalues(PlotsController.Start)) do
        if type(up) == "table"
            and type(up.GetLocalReplica) == "function"
            and type(up.WaitForLocalReplica) == "function" then
            ReplicaController = up
            break
        end
    end

    assert(ReplicaController, "Không tìm thấy ReplicaController.")

    LocalReplica = ReplicaController:GetLocalReplica()

    if not LocalReplica then
        LocalReplica = ReplicaController:WaitForLocalReplica()
    end
    assert(LocalReplica, "Không tìm thấy LocalReplica.")

    return LocalReplica
end

local function CountCarrotSeeds()
    local ok, amount = pcall(function()
        local Replica = GetLocalReplica()
        local Data = Replica.Data
        local Inventory = Data.Inventory
        local Seeds = Inventory.Seeds or {}
        return tonumber(Seeds.Carrot or 0)
    end)

    if ok then
        return amount
    end

    return 0
end

local function CountCarrots()
    local Plot = GetPlot()
    local Plants = Plot:WaitForChild("Plants")

    local carrot = 0

    for _, Plant in ipairs(Plants:GetChildren()) do
        local SeedName = Plant:GetAttribute("SeedName")
        if SeedName and tostring(SeedName):lower():find("carrot") then
            carrot += 1
        end
    end

    return carrot
end

local function GetPlotExpandText()
    local ok, value = pcall(function()
        local Replica = GetLocalReplica()
        local Data = Replica.Data
        local owned = tonumber(Data.OwnedExpansions or 0)

        if owned < 0 then owned = 0 end
        if owned > MAX_EXPAND_LEVEL then owned = MAX_EXPAND_LEVEL end

        return tostring(owned) .. " / " .. tostring(MAX_EXPAND_LEVEL)
    end)

    if ok then
        return value
    end

    return "? / " .. tostring(MAX_EXPAND_LEVEL)
end

local FruitAPI

local function GetFruitAPI()
    if FruitAPI then
        return FruitAPI
    end

    local ok, Module = pcall(function()
        return require(Controllers:WaitForChild("PlantHoverTooltipController"))
    end)

    if not ok or type(Module) ~= "table" then
        warn("Không require được PlantHoverTooltipController.")
