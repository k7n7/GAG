    task.wait(1.5)
end


-- SPRINKLER BACKGROUND LOOP
-- Chạy độc lập để không phải chờ plant/harvest xong mới đặt bên thứ 2.
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            PlaceSuperSprinklers()
        end)
    end
end)

-- MAIN LOGIC
local cycle = 0

local function FarmCycle()
    cycle += 1

    SetStatus("Harvesting & Selling")
    HarvestAndSellUnder20kg()

    if cycle % EXPAND_EVERY_CYCLES == 0 then
        SetStatus("Expanding Plot")
        ExpandPlotToMax5()
    end

    local seedCount = CountCarrotSeeds()

    if seedCount <= 0 then
        SetStatus("Buying Carrot")
        BuyCarrotAll()
        task.wait(0.35)
        seedCount = CountCarrotSeeds()
    end

    SetStatus("Going Garden")
    TeleportGardenIfNeeded()

    SetStatus("Placing Sprinkler")
    PlaceSuperSprinklers()

    if seedCount > 0 then
        SetStatus("Ray Planting")
        PlantAllCarrot(true)
    else
        SetStatus("Waiting Carrot Stock")
    end

    SetStatus("Cycle Done")
end

if RUN_FOREVER then
    while true do
        local ok, err = pcall(FarmCycle)
        if not ok then
            warn("FARM CYCLE ERROR:", err)
        end

        task.wait(LOOP_DELAY)
    end
else
    FarmCycle()
end
