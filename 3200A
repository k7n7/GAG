    end
end)

-- ===================== BUY / EXPAND =====================
local function BuyCarrotAll()
    if not AUTO_BUY_CARROT then return false end
    if tick() < NextBuyTime then return false end

    local last = CountCarrotSeeds()
    local success = false
    local fail = 0

    for _ = 1, BUY_MAX_ATTEMPTS do
        pcall(function()
            Net.SeedShop.PurchaseSeed:Fire("Carrot")
        end)
        task.wait(BUY_DELAY)

        local now = CountCarrotSeeds()
        if now > last then
            success = true
            last = now
            fail = 0
        else
            fail += 1
        end
        if fail >= 5 then break end
    end

    if not success then
        NextBuyTime = tick() + BUY_COOLDOWN
    end
    return success
end

local function ExpandPlotToMax5()
    if not AUTO_EXPAND then return end
    for _ = 1, MAX_EXPAND_LEVEL do
        pcall(function()
            Net.Actions.ExpandGarden:Fire()
        end)
        task.wait(0.45)
    end
    -- Remote có thể trả về trước khi 4 tấm đất mới replicate xong.
    -- FarmCycle ngay sau đó sẽ gọi GetPlantAreas và lập grid trên toàn bộ phần mới.
    task.wait(EXPAND_REPLICATION_WAIT)
    NextSprinklerCheck = 0
end

-- ===================== SPRINKLER 2 GIỮA VƯỜN =====================
local function CountSuperSprinklers()
    local plot = GetPlot()
    local sprinklers = plot:WaitForChild("Sprinklers")
    return #sprinklers:GetChildren()
end

local function GetSprinklerTargetPositions()
    local areas = GetPlantAreas()
    local targets = {}
    if #areas <= 0 then return targets end

    local center = Vector3.new(0, 0, 0)
    local minX, maxX = math.huge, -math.huge
    local minZ, maxZ = math.huge, -math.huge
    for _, area in ipairs(areas) do
        center += area.Position
        minX = math.min(minX, area.Position.X)
        maxX = math.max(maxX, area.Position.X)
        minZ = math.min(minZ, area.Position.Z)
        maxZ = math.max(maxZ, area.Position.Z)
    end
    center /= #areas

    -- Chia vườn theo trục có độ trải lớn hơn, sau đó lấy tâm từng nửa.
    -- Như vậy sprinkler nằm giữa hai bên vườn, không phải hai PlantArea ngẫu nhiên gần tâm.
    local splitX = (maxX - minX) >= (maxZ - minZ)
    local sums = {Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)}
    local counts = {0, 0}
    for _, area in ipairs(areas) do
        local side
        if splitX then
            side = area.Position.X < center.X and 1 or 2
        else
            side = area.Position.Z < center.Z and 1 or 2
        end
        sums[side] += area.Position
        counts[side] += 1
    end

    for side = 1, 2 do
        if counts[side] > 0 then
            table.insert(targets, sums[side] / counts[side] + Vector3.new(0, 0.2, 0))
        end
    end

    -- Plot chỉ có một area: đặt hai điểm đối xứng trong area đó.
    if #targets == 1 and MAX_SPRINKLER_TARGETS >= 2 then
        local area = areas[1]
        local offset
        if area.Size.X >= area.Size.Z then
            offset = Vector3.new(area.Size.X * 0.25, 0, 0)
        else
            offset = Vector3.new(0, 0, area.Size.Z * 0.25)
        end
        targets = {
            area.Position - offset + Vector3.new(0, 0.2, 0),
            area.Position + offset + Vector3.new(0, 0.2, 0)
        }
    end

    return targets
end

local function IsSuperSprinklerNear(pos)
    local plot = GetPlot()
    local sprinklers = plot:WaitForChild("Sprinklers")

    for _, sprinkler in ipairs(sprinklers:GetChildren()) do
        local part = sprinkler.PrimaryPart or sprinkler:FindFirstChildWhichIsA("BasePart", true)
        if part then
            local a = Vector3.new(pos.X, 0, pos.Z)
            local b = Vector3.new(part.Position.X, 0, part.Position.Z)
            if (a - b).Magnitude <= SPRINKLER_RADIUS then
                return true
            end
        end
    end
    return false
end

local function WaitForSuperSprinklerModel(timeout)
    timeout = timeout or 1.6
    local started = tick()

    while tick() - started < timeout do
        RefreshCharacter()

        local playerFolder = workspace:FindFirstChild(Player.Name)
        if playerFolder then
            for _, obj in ipairs(playerFolder:GetChildren()) do
                local n = obj.Name:lower()
                if n:find("super") and n:find("sprinkler") then
                    return obj
                end
            end
        end

        for _, tool in ipairs(Character:GetChildren()) do
            local n = tool.Name:lower()
            if tool:IsA("Tool") and n:find("super") and n:find("sprinkler") then
                return tool
            end
        end

        local backpack = Player:FindFirstChild("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                local n = tool.Name:lower()
                if tool:IsA("Tool") and n:find("super") and n:find("sprinkler") then
                    Humanoid:EquipTool(tool)
                    task.wait(0.15)
                    break
                end
            end
        end

        task.wait(0.08)
    end

    return nil
end

local function PlaceOneSprinkler(pos)
    for _ = 1, 3 do
        local before = CountSuperSprinklers()
        local toolModel = WaitForSuperSprinklerModel(1.6)
        if not toolModel then return false end

        pcall(function()
            Net.Place.PlaceSprinkler:Fire(pos, "Super Sprinkler", toolModel, 1)
        end)

        task.wait(0.55)
        if IsSuperSprinklerNear(pos) or CountSuperSprinklers() > before then
            return true
        end
    end
    return false
end

local function PlaceSuperSprinklers()
    if tick() < NextSprinklerCheck then return end

    for _, pos in ipairs(GetSprinklerTargetPositions()) do
        if not IsSuperSprinklerNear(pos) then
            PlaceOneSprinkler(pos)
            NextSprinklerCheck = tick() + 1.1
            return
        end
    end

    NextSprinklerCheck = tick() + 1
end

-- sprinkler chạy nền, không chờ plant/harvest xong mới đặt.
task.spawn(function()
    while task.wait(SPRINKLER_BACKGROUND_WAIT) do
        pcall(PlaceSuperSprinklers)
    end
end)

-- ===================== TELEPORT / MAIN =====================
local function IsNearGarden()
    RefreshCharacter()
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local areas = GetPlantAreas()
    if #areas <= 0 then return false end

    local center = Vector3.new(0, 0, 0)
    for _, area in ipairs(areas) do
        center += area.Position
    end
    center /= #areas

    return (hrp.Position - center).Magnitude < 180
end

local function TeleportGardenIfNeeded()
    if IsNearGarden() then return end
    pcall(function()
        Net.TeleportButton.Request:Fire("Garden")
    end)
    task.wait(0.9)
end

local function FarmCycle()
    cycle += 1

    -- Harvest và sell đã có worker nền riêng, không chặn plant/FarmCycle.

    if AUTO_EXPAND and cycle % EXPAND_EVERY_CYCLES == 0 then
        ExpandPlotToMax5()
    end

    local seeds = CountCarrotSeeds()
    if seeds <= 0 then
        BuyCarrotAll()
        seeds = CountCarrotSeeds()
    end

    TeleportGardenIfNeeded()
    PlaceSuperSprinklers()

    if seeds > 0 then
        PlantAllCarrot(true)
    end
end

print("TRUNGPHANHUB SPEED RESTORE FINAL STARTED")

while true do
    local ok, err = pcall(FarmCycle)
    if not ok then
        warn("FARM ERROR:", err)
    end
    task.wait(LOOP_DELAY)
end
