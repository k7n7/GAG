-- ===================== PLANT AREAS / GRID =====================
local function GetPlantAreas()
    local plot = GetPlot()
    local areas = {}
    local seen = {}
    local positionKeys = {}
    local plantsFolder = plot:FindFirstChild("Plants")
    local sprinklersFolder = plot:FindFirstChild("Sprinklers")

    -- Dùng chính RaycastParams của PlantController để xác nhận mặt có thể plant.
    -- Params được tạo lại mỗi lần quét nên tự nhận các phần mở rộng trong tương lai.
    local plantAreaParams = nil
    pcall(function()
        local params = PlantController:CreatePlantAreaParams()
        if typeof(params) == "RaycastParams" then
            plantAreaParams = params
        end
    end)

    local function rayHitsPlantArea(obj)
        if not plantAreaParams then return true end
        local result = workspace:Raycast(
            obj.Position + Vector3.new(0, 100, 0),
            Vector3.new(0, -250, 0),
            plantAreaParams
        )
        return result ~= nil
    end

    local function add(obj)
        if not obj or not obj:IsA("BasePart") or seen[obj] then return end

        if plantsFolder and obj:IsDescendantOf(plantsFolder) then return end
        if sprinklersFolder and obj:IsDescendantOf(sprinklersFolder) then return end

        -- Loại viền, cọc, particle part...; chỉ giữ mặt đất ngang đủ lớn để có grid.
        if obj.Size.X < PLANT_SPACING * 1.5 or obj.Size.Z < PLANT_SPACING * 1.5 then return end
        if math.abs(obj.CFrame.UpVector.Y) < 0.75 then return end
        if not rayHitsPlantArea(obj) then return end

        seen[obj] = true

        -- Nhiều plot có cả soil visual và hitbox trùng tâm. Chỉ lập grid một lần.
        local k = tostring(math.floor(obj.Position.X * 2 + 0.5))
            .. ":" .. tostring(math.floor(obj.Position.Z * 2 + 0.5))
        if positionKeys[k] then return end
        positionKeys[k] = true
        table.insert(areas, obj)
    end

    -- Không còn phụ thuộc Visual.PlantAreaColumn1/2 hay tên instance.
    -- Mọi BasePart phù hợp trong plot đều được kiểm tra bằng plant-area raycast.
    for _, obj in ipairs(plot:GetDescendants()) do
        if obj:IsA("BasePart") then
            add(obj)
        end
    end

    table.sort(areas, function(a, b)
        if math.abs(a.Position.X - b.Position.X) > 2 then
            return a.Position.X < b.Position.X
        end
        return a.Position.Z < b.Position.Z
    end)

    if (DEBUG or DEBUG_EXPAND_PATHS) and #areas ~= LastPlantAreaCount then
        LastPlantAreaCount = #areas
        print("[GRID] Plant areas detected:", #areas)
        if DEBUG_EXPAND_PATHS then
            for index, area in ipairs(areas) do
                print("[GRID AREA]", index, area:GetFullName(), "SIZE", area.Size, "POS", area.Position)
            end
        end
    end

    return areas
end

local function GetEmptyPlantPositions()
    local plot = GetPlot()
    local plants = plot:WaitForChild("Plants")
    local positions = {}
    local occupied = {}
    local used = {}
    local plantAreaParams = nil

    pcall(function()
        local params = PlantController:CreatePlantAreaParams()
        if typeof(params) == "RaycastParams" then
            plantAreaParams = params
        end
    end)

    for _, plant in ipairs(plants:GetChildren()) do
        local part = plant:FindFirstChild("HarvestPart") or plant.PrimaryPart or plant:FindFirstChildWhichIsA("BasePart")
        if part then
            table.insert(occupied, Vector3.new(part.Position.X, 0, part.Position.Z))
        end
    end

    local function key(pos)
        return tostring(math.floor(pos.X + 0.5)) .. ":" .. tostring(math.floor(pos.Z + 0.5))
    end

    local function free(pos)
        local flat = Vector3.new(pos.X, 0, pos.Z)
        for _, p in ipairs(occupied) do
            if (flat - p).Magnitude < PLANT_SPACING then
                return false
            end
        end
        return true
    end

    local function snapToPlantArea(pos)
        if not plantAreaParams then return pos end
        local result = workspace:Raycast(
            pos + Vector3.new(0, 100, 0),
            Vector3.new(0, -250, 0),
            plantAreaParams
        )
        if not result then return nil end
        return Vector3.new(pos.X, result.Position.Y, pos.Z)
    end

    for _, area in ipairs(GetPlantAreas()) do
        local c, s = area.Position, area.Size
        for x = c.X - s.X/2 + PLANT_SPACING, c.X + s.X/2 - PLANT_SPACING, PLANT_SPACING do
            for z = c.Z - s.Z/2 + PLANT_SPACING, c.Z + s.Z/2 - PLANT_SPACING, PLANT_SPACING do
                local pos = snapToPlantArea(Vector3.new(x, c.Y, z))
                local k = pos and key(pos) or nil
                if pos and not used[k] and free(pos) then
                    used[k] = true
                    table.insert(positions, pos)
                end
            end
        end
    end

    return positions
end

local function PlantAt(pos)
    -- Logic Ray nhanh kiểu cũ: không direct remote làm chính.
    -- Bắn từ trên xuống để không cần xoay camera/tele từng cây.
    local ray = Ray.new(pos + Vector3.new(0, 80, 0), Vector3.new(0, -200, 0))
    local ok = pcall(function()
        PlantController:TryPlantWithRay(ray)
    end)
    return ok
end

local function PlantAllCarrot(alreadyAtGarden)
    if not alreadyAtGarden then
        pcall(function() Net.TeleportButton.Request:Fire("Garden") end)
        task.wait(0.4)
    end

    -- Không cho Carrot tool thay thế Super Sprinkler trong lúc packet placement đang chạy.
    while SprinklerPlacing do
        task.wait(0.02)
    end
    PlantingActive = true

    local ok, err = pcall(function()
        -- TryPlantWithRay đi qua scheduler/debounce của controller.
        for pass = 1, PLANT_RESCAN_PASSES do
            local seedCount = CountCarrotSeeds()
            if seedCount <= 0 then return end
            if not GetCarrotTool() then return end

            local positions = GetEmptyPlantPositions()
            if #positions <= 0 then return end

            local amount = math.min(#positions, seedCount)
            for i = 1, amount do
                PlantAt(positions[i])
                if i % PLANT_RAYS_PER_HEARTBEAT == 0 then
                    RunService.Heartbeat:Wait()
                end
            end

            -- Cho Plants replicate về rồi lần sau chỉ nhằm vào ô còn trống.
            if pass < PLANT_RESCAN_PASSES then
                task.wait(PLANT_RESCAN_WAIT)
            end
        end
    end)

    PlantingActive = false
    if not ok then
        error(err)
    end
end

-- ===================== HARVEST + SELL =====================
-- Mỗi plant chỉ có một watcher. Các watcher chạy song song, nên 30 cây cùng chín
-- sẽ được bắn prompt trong cùng khung thời gian, không chờ FarmCycle quét tuần tự.
local HarvestWatchers = setmetatable({}, {__mode = "k"})

local function ValidKg(value)
    return type(value) == "number" and value == value and value >= 0
end

-- Nếu UI label tồn tại, dùng nó làm lớp kiểm tra thứ hai độc lập với FruitAPI.
-- Trả về: kg, labelExists. Label có nhưng chưa parse được => fail-closed.
local function GetPlantLabelKg(plant)
    local labelRoot = plant:FindFirstChild("HarvestPromptLabel", true)
    if not labelRoot then return nil, false end

    for _, obj in ipairs(labelRoot:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local text = tostring(obj.Text or ""):lower()
            local parsed = text:match("([%d%.]+)%s*kg")
            local kg = parsed and tonumber(parsed) or nil
            if ValidKg(kg) then
                return kg, true
            end
        end
    end

    return nil, true
end

local function IsDefinitelySafeToHarvest(plant)
    -- Không cache. Luôn lấy giá trị mới ngay trước thời điểm harvest.
    local kg1 = GetPlantKg(plant)
    local labelKg1, labelExists1 = GetPlantLabelKg(plant)

    if not ValidKg(kg1) then return false, false end
    if labelExists1 and not ValidKg(labelKg1) then return false, false end
    if kg1 >= MIN_KEEP_KG or (labelKg1 and labelKg1 >= MIN_KEEP_KG) then
        return false, true
    end

    if HARVEST_DOUBLE_CHECK then
        RunService.Heartbeat:Wait()
        if not plant.Parent then return false, false end

        local kg2 = GetPlantKg(plant)
        local labelKg2, labelExists2 = GetPlantLabelKg(plant)
        if not ValidKg(kg2) then return false, false end
        if labelExists2 and not ValidKg(labelKg2) then return false, false end
        if kg2 >= MIN_KEEP_KG or (labelKg2 and labelKg2 >= MIN_KEEP_KG) then
            return false, true
        end
    end

    return true, false
end

local function WatchHarvestPlant(plant)
    if HarvestWatchers[plant] then return end
    HarvestWatchers[plant] = true

    task.spawn(function()
        while plant and plant.Parent do
            local seed = plant:GetAttribute("SeedName")
            if seed and tostring(seed):lower():find("carrot") then
                local prompt = GetHarvestPrompt(plant)
                if prompt and prompt.Enabled then
                    local safe, protected = IsDefinitelySafeToHarvest(plant)
                    if protected then
                        -- Chỉ cần một trong hai nguồn/đợt đọc thấy >=20kg: khóa cây này vĩnh viễn.
                        break
                    end

                    if safe and plant.Parent and prompt.Parent and prompt.Enabled then
                        pcall(function()
                            prompt.MaxActivationDistance = 999999
                            prompt.RequiresLineOfSight = false
                            fireproximityprompt(prompt)
                        end)
                        HarvestAttemptsSinceSell += 1
                    end

                    -- Nếu prompt đầu bị scheduler nuốt, retry nhanh; plant biến mất thì loop tự dừng.
                    task.wait(HARVEST_RETRY_WAIT)
                else
                    task.wait(HARVEST_POLL_INTERVAL)
                end
            else
                -- Attribute SeedName thường replicate sau model một chút.
                task.wait(HARVEST_POLL_INTERVAL)
            end
        end

        HarvestWatchers[plant] = nil
    end)
end

local function StartInstantHarvestEngine()
    local plot = GetPlot()
    local plants = plot:WaitForChild("Plants")

    for _, plant in ipairs(plants:GetChildren()) do
        WatchHarvestPlant(plant)
    end

    plants.ChildAdded:Connect(function(plant)
        -- Watch ngay khi model vào Plants; watcher tự chờ attribute/prompt replicate.
        WatchHarvestPlant(plant)
    end)
end

