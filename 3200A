-- HELPERS
local function getMyPlot()
    for _, plot in ipairs(workspace.Gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                if plant:GetAttribute("UserId") == plr.UserId then
                    return plot
                end
            end
        end
    end
    return workspace.Gardens:FindFirstChild("Plot1")
end

local function getPlantArea(plot)
    return plot:FindFirstChild("PlotSizeReference") or plot.Visual:FindFirstChild("GardenTotalArea")
end

local function countPlants(plot)
    local p = plot and plot:FindFirstChild("Plants")
    return p and #p:GetChildren() or 0
end

local function countSprinklers(plot)
    local s = plot and plot:FindFirstChild("Sprinklers")
    return s and #s:GetChildren() or 0
end

local function findTool(keyword)
    keyword = keyword:lower()
    for _, v in ipairs(plr.Backpack:GetChildren()) do
        if v:IsA("Tool") and v.Name:lower():find(keyword) then
            return v
        end
    end
    for _, v in ipairs(char():GetChildren()) do
        if v:IsA("Tool") and v.Name:lower():find(keyword) then
            return v
        end
    end
end

local function equipTool(keyword)
    local tool = findTool(keyword)
    if not tool then return false end
    char():FindFirstChildOfClass("Humanoid"):EquipTool(tool)
    task.wait(0.2)
    return true
end

local function closeSeedShop()
    local shop = plr.PlayerGui:FindFirstChild("SeedShop")
    if shop then
        local closeBtn
        for _, v in ipairs(shop:GetDescendants()) do
            if v:IsA("GuiButton") and (v.Name:lower():find("close") or tostring(v.Text):find("X")) then
                closeBtn = v
                break
            end
        end

        if closeBtn then
            pcall(function() firesignal(closeBtn.MouseButton1Click) end)
            pcall(function() firesignal(closeBtn.Activated) end)
        end

        task.wait(0.2)
        if shop then
            shop.Enabled = false
        end
    end
end

local function clickButton(btn)
    if not btn then return false end
    pcall(function() firesignal(btn.MouseButton1Click) end)
    pcall(function() firesignal(btn.Activated) end)
    return true
end

-- BUY
local function openSeedShop()
    local prompt = workspace.NPCS.Sam.HumanoidRootPart:FindFirstChild("ProximityPrompt")
    if not prompt then return false end

    prompt.MaxActivationDistance = 999999
    prompt.RequiresLineOfSight = false
    fireproximityprompt(prompt)
    task.wait(1)
    return plr.PlayerGui:FindFirstChild("SeedShop") ~= nil
end

local function buyCarrots()
    setStatus("Buying Carrot")
    updateUI()

    if not openSeedShop() then
        stats.LastError = "Cannot open SeedShop"
        return
    end

    local shop = plr.PlayerGui:FindFirstChild("SeedShop")
    local normal = shop and shop.Frame and shop.Frame:FindFirstChild("NormalShop")
    if not normal then
        stats.LastError = "No NormalShop"
        return
    end

    local carrot = normal:FindFirstChild("Carrot")
    local shelf = normal:FindFirstChild("Sheckles_Shelf")
    if not carrot or not shelf then
        stats.LastError = "No carrot/shelf"
        closeSeedShop()
        return
    end

    local stockText = carrot.Main_Frame.Stock_Text.Text
    local stock = tonumber(stockText:match("x(%d+)")) or 0
    local buyButton = shelf.Main_Frame.Buttons:FindFirstChild("BuyButton")

    if stock <= 0 then
        closeSeedShop()
        return
    end

    for i = 1, stock do
        clickButton(carrot)
        task.wait(0.15)
        clickButton(buyButton)
        task.wait(0.25)

        if findTool("carrot") then
            stats.Bought += 1
        end

        updateUI()
    end

    closeSeedShop()
end

-- POSITION
local function makeRay(pos)
    return Ray.new(pos + Vector3.new(0, 80, 0), Vector3.new(0, -160, 0))
end

local function occupied(plot, pos)
    local plants = plot:FindFirstChild("Plants")
    if plants then
        for _, plant in ipairs(plants:GetChildren()) do
            local base = plant:FindFirstChild("Base") or plant:FindFirstChild("HarvestPart", true)
            if base and (base.Position - pos).Magnitude < 4 then
                return true
            end
        end
    end
    return false
end

-- SPRINKLER
local function hasSuperSprinkler(plot)
    local sprinklers = plot:FindFirstChild("Sprinklers")
    if not sprinklers then return false end

    for _, v in ipairs(sprinklers:GetChildren()) do
        if v.Name:lower():find("super") then
            return true
        end
    end
    return false
end

local function placeSuperSprinkler()
    if not USE_SUPER_SPRINKLER then return end

    local plot = getMyPlot()
    local area = plot and getPlantArea(plot)
    if not plot or not area then return end

    if hasSuperSprinkler(plot) then
        stats.Sprinkler = "Active"
        return
    end

    if not equipTool("super sprinkler") then
        stats.Sprinkler = "No Tool"
        return
    end

    setStatus("Placing Sprinkler")
    updateUI()

    local before = countSprinklers(plot)
    local pos = area.Position + Vector3.new(0, 2, 0)

    local ok, err = pcall(function()
        SprinklerController.TryPlace(SprinklerController, makeRay(pos))
    end)

    if not ok then
        stats.LastError = "Sprinkler: " .. tostring(err)
    end

    task.wait(1)

    if countSprinklers(plot) > before or hasSuperSprinkler(plot) then
        stats.Sprinkler = "Active"
    else
        stats.Sprinkler = "Failed"
    end
end

-- PLANT
local function plantCarrots()
    local plot = getMyPlot()
    local area = plot and getPlantArea(plot)
    if not plot or not area then return end

    if not equipTool("carrot") then
        stats.LastError = "No carrot tool"
        return
    end

    setStatus("Planting Carrots")
    updateUI()

    local size = area.Size
    local cf = area.CFrame
    local tries = 0

    for x = -size.X / 2 + 4, size.X / 2 - 4, 4 do
        for z = -size.Z / 2 + 4, size.Z / 2 - 4, 4 do
            if tries >= PLANT_PER_LOOP then return end

            if not equipTool("carrot") then return end

            local pos = (cf * CFrame.new(x, 2, z)).Position

            if not occupied(plot, pos) then
                local before = countPlants(plot)

                local ok, err = pcall(function()
                    PlantController.TryPlantWithRay(PlantController, makeRay(pos))
                end)

                if not ok then
                    stats.LastError = "Plant: " .. tostring(err)
                end

                task.wait(0.35)

                local after = countPlants(plot)
                if after > before then
                    stats.Planted += 1
                end

                tries += 1
                updateUI()
            end
        end
    end
end

-- KG + HARVEST
local sent = {}

local function getKg(plant)
    local label = plant:FindFirstChild("HarvestPromptLabel", true)
    local nameLabel = label and label:FindFirstChild("Name", true)
    if not nameLabel or not nameLabel:IsA("TextLabel") then return nil end
    return tonumber(nameLabel.Text:match("([%d%.]+)kg"))
end

local function sendWebhook(kg)
    if WEBHOOK_URL == "" then return end

    local req = syn and syn.request or http_request or request
    if not req then return end

    pcall(function()
        req({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                embeds = {{
                    title = "🥕 BIG CARROT !!!",
                    color = 16753920,
                    fields = {
                        {name = "KG", value = tostring(kg), inline = true}
                    },
                    footer = {text = "TPDT Carrot Keeper"}
                }}
            })
        })
    end)
end

local function harvestCarrots()
    local plot = getMyPlot()
    if not plot or not plot:FindFirstChild("Plants") then return end

    setStatus("Scanning Carrots")
    updateUI()

    for _, plant in ipairs(plot.Plants:GetChildren()) do
        if plant:GetAttribute("SeedName") == "Carrot" and plant:GetAttribute("PlantGrowthReady") == true then
            local prompt = plant:FindFirstChild("HarvestPrompt", true)
            local part = plant:FindFirstChild("HarvestPart", true)

            if prompt then
                prompt.MaxActivationDistance = 999999
                prompt.RequiresLineOfSight = false
            end

            local kg = getKg(plant)

            if not kg and part then
                hrp().CFrame = part.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.2)
                kg = getKg(plant)
            end

            if kg then
                if kg >= KEEP_KG then
                    if not sent[plant.Name] then
                        sent[plant.Name] = true
                        stats.Big += 1
                        sendWebhook(kg)
                    end
                else
                    if prompt then
                        fireproximityprompt(prompt)
                        stats.Harvested += 1
                        task.wait(0.15)
                    end
                end
            end

            updateUI()
        end
    end
end

