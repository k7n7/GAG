local function SnapSprinklerTarget(pos)
    local params = nil
    pcall(function()
        local created = PlantController:CreatePlantAreaParams()
        if typeof(created) == "RaycastParams" then
            params = created
        end
    end)

    local result = workspace:Raycast(
        pos + Vector3.new(0, 100, 0),
        Vector3.new(0, -250, 0),
        params
    )
    if result then
        return result.Position + Vector3.new(0, 0.15, 0)
    end
    return pos
end

local function GetSprinklerTargetPositions()
    local areas = GetPlantAreas()
    local targets = {}
    if #areas <= 0 then return targets end

    -- Dựng danh sách điểm phủ từ chính grid có thể plant, không trung bình
    -- Position của các visual part vì visual/hitbox có thể lệch giữa account.
    local params = nil
    pcall(function()
        local created = PlantController:CreatePlantAreaParams()
        if typeof(created) == "RaycastParams" then
            params = created
        end
    end)

    local points = {}
    local used = {}
    for _, area in ipairs(areas) do
        local c, s = area.Position, area.Size
        for x = c.X - s.X/2 + PLANT_SPACING, c.X + s.X/2 - PLANT_SPACING, PLANT_SPACING do
            for z = c.Z - s.Z/2 + PLANT_SPACING, c.Z + s.Z/2 - PLANT_SPACING, PLANT_SPACING do
                local result = workspace:Raycast(
                    Vector3.new(x, c.Y + 100, z),
                    Vector3.new(0, -250, 0),
                    params
                )
                if result then
                    local key = tostring(math.floor(x + 0.5)) .. ":" .. tostring(math.floor(z + 0.5))
                    if not used[key] then
                        used[key] = true
                        table.insert(points, Vector3.new(x, result.Position.Y, z))
                    end
                end
            end
        end
    end

    if #points < 2 then return targets end

    local function getObjectPosition(obj)
        if not obj then return nil end
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Model") then return obj:GetPivot().Position end

        local sum = Vector3.new(0, 0, 0)
        local count = 0
        for _, part in ipairs(obj:GetDescendants()) do
            if part:IsA("BasePart") then
                sum += part.Position
                count += 1
            end
        end
        return count > 0 and sum / count or nil
    end

    -- PlantAreaColumn1/2 cho biết hướng "hai bên" ngay cả khi plot quay 90 độ.
    local plot = GetPlot()
    local visual = plot:FindFirstChild("Visual")
    local column1 = visual and visual:FindFirstChild("PlantAreaColumn1", true)
    local column2 = visual and visual:FindFirstChild("PlantAreaColumn2", true)
    local p1, p2 = getObjectPosition(column1), getObjectPosition(column2)
    local splitX

    if p1 and p2 then
        splitX = math.abs(p2.X - p1.X) >= math.abs(p2.Z - p1.Z)
    else
        -- Fallback: trục có khoảng hở lớn nhất giữa các điểm grid.
        local function largestGap(axis)
            local values = {}
            for _, point in ipairs(points) do
                table.insert(values, axis == "X" and point.X or point.Z)
            end
            table.sort(values)
            local best = 0
            for i = 2, #values do
                best = math.max(best, values[i] - values[i - 1])
            end
            return best
        end
        splitX = largestGap("X") >= largestGap("Z")
    end

    local minValue, maxValue = math.huge, -math.huge
    for _, point in ipairs(points) do
        local value = splitX and point.X or point.Z
        minValue = math.min(minValue, value)
        maxValue = math.max(maxValue, value)
    end
    local splitValue = (minValue + maxValue) / 2

    local sums = {Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)}
    local counts = {0, 0}
    local groups = {{}, {}}
    for _, point in ipairs(points) do
        local value = splitX and point.X or point.Z
        local side = value < splitValue and 1 or 2
        sums[side] += point
        counts[side] += 1
        table.insert(groups[side], point)
    end

    for side = 1, 2 do
        if counts[side] > 0 then
            local centroid = sums[side] / counts[side]
            local closest = nil
            local closestDistance = math.huge
            for _, point in ipairs(groups[side]) do
                local distance = (Vector3.new(point.X, 0, point.Z)
                    - Vector3.new(centroid.X, 0, centroid.Z)).Magnitude
                if distance < closestDistance then
                    closest = point
                    closestDistance = distance
                end
            end
            -- Dùng grid point thật gần tâm nhất, không đặt vào khe giữa hai soil panel.
            table.insert(targets, SnapSprinklerTarget(closest or centroid))
        end
    end

    if DEBUG_SPRINKLER then
        print("[SPRINKLER TARGETS]", #targets, "POINTS", #points, "SPLIT", splitX and "X" or "Z")
        for index, target in ipairs(targets) do
            print("[SPRINKLER TARGET]", index, target)
        end
    end

    return targets
end

local function IsSuperSprinklerNear(pos)
    local plot = GetPlot()
    local sprinklers = plot:WaitForChild("Sprinklers")

    for _, sprinkler in ipairs(sprinklers:GetChildren()) do
        -- Lỗi cũ: sprinkler thường cũng làm hàm trả true, khiến account bị skip Super Sprinkler.
        if IsSuperSprinklerObject(sprinkler) then
            local part = sprinkler.PrimaryPart or sprinkler:FindFirstChildWhichIsA("BasePart", true)
            if not part then continue end
            local a = Vector3.new(pos.X, 0, pos.Z)
            local b = Vector3.new(part.Position.X, 0, part.Position.Z)
            if (a - b).Magnitude <= SPRINKLER_RADIUS then
                return true
            end
        end
    end
    return false
end

local function IsAnyPlacedSprinklerNear(pos)
    local plot = GetPlot()
    local sprinklers = plot:WaitForChild("Sprinklers")
    local target = Vector3.new(pos.X, 0, pos.Z)

    for _, sprinkler in ipairs(sprinklers:GetChildren()) do
        -- Không phụ thuộc tên/attribute. Folder Sprinklers là trạng thái thật của plot.
        if sprinkler:IsA("BasePart") then
            local at = Vector3.new(sprinkler.Position.X, 0, sprinkler.Position.Z)
            if (target - at).Magnitude <= SPRINKLER_RADIUS then
                return true
            end
        end

        for _, part in ipairs(sprinkler:GetDescendants()) do
            if part:IsA("BasePart") then
                local at = Vector3.new(part.Position.X, 0, part.Position.Z)
                if (target - at).Magnitude <= SPRINKLER_RADIUS then
                    return true
                end
            end
        end
    end
    return false
end

local function IsSprinklerTargetOccupied(pos)
    -- Nhận diện Super nếu metadata có sẵn; fallback về bất kỳ object thật nào
    -- trong Plot.Sprinklers gần target để tuyệt đối không đặt chồng.
    return IsSuperSprinklerNear(pos) or IsAnyPlacedSprinklerNear(pos)
end

local function FindSuperSprinklerTool(root)
    if not root then return nil end

    if root:IsA("Tool") and IsSuperSprinklerObject(root) then
        return root
    end
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("Tool") and IsSuperSprinklerObject(obj) then
            return obj
        end
    end
    return nil
end

local function FindSuperSprinklerModel(root)
    if not root then return nil end

    if (root:IsA("Model") or root:IsA("Tool")) and HasSuperSprinklerMetadata(root) then
        return root
    end
    for _, obj in ipairs(root:GetDescendants()) do
        if HasSuperSprinklerMetadata(obj) then
            local candidate = obj
            while candidate and candidate ~= root do
                if candidate:IsA("Model") or candidate:IsA("Tool") then
                    return candidate
                end
                candidate = candidate.Parent
            end
        end
    end
    return nil
end

local function DumpSprinklerCandidates()
    if not DEBUG_SPRINKLER then return end
    print("[SPRINKLER DEBUG] No usable Super Sprinkler instance. Tool candidates:")
    local roots = {Character, Player:FindFirstChild("Backpack"), workspace:FindFirstChild(Player.Name)}
    for _, root in ipairs(roots) do
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("Tool") or obj:IsA("Model") then
                    local attrs = obj:GetAttributes()
                    print("[SPRINKLER CANDIDATE]", obj:GetFullName(), obj.ClassName, attrs)
                end
            end
        end
    end
end

local function WaitForSuperSprinklerModel(timeout)
    timeout = timeout or 1.6
    local started = tick()

    while tick() - started < timeout do
        RefreshCharacter()

        -- Ưu tiên Tool đang equip.
        local equipped = FindSuperSprinklerTool(Character)
        if equipped then
            return equipped
        end

        local backpack = Player:FindFirstChild("Backpack")
        local storedTool = FindSuperSprinklerTool(backpack)
        if storedTool then
            pcall(function()
                Humanoid:EquipTool(storedTool)
            end)
            task.wait(0.12)
            return FindSuperSprinklerTool(Character) or storedTool
        end

        -- Một số account/build tạo placement model lồng sâu trong workspace.<PlayerName>.
        local playerFolder = workspace:FindFirstChild(Player.Name)
        local placementModel = FindSuperSprinklerModel(playerFolder)
        if placementModel then
            return placementModel
        end

        task.wait(0.08)
    end

    DumpSprinklerCandidates()
    return nil
end

local function PlaceOneSprinkler(pos)
    -- Chờ plant nhả Carrot tool; đồng thời chặn hai sprinkler worker chạy trùng nhau.
    while PlantingActive or SprinklerPlacing do
        task.wait(0.03)
    end
    SprinklerPlacing = true

    local success = false
    local ok, placeError = pcall(function()
        for _ = 1, 3 do
            -- Kiểm tra lại ngay trước mỗi attempt; worker khác hoặc sprinkler cũ có thể đã chiếm target.
            if IsSprinklerTargetOccupied(pos) then
                success = true
                return
            end

            local beforeAll = CountAllPlacedSprinklers()
            local toolModel = WaitForSuperSprinklerModel(1.6)
            if not toolModel then return end

            local fired, fireError = pcall(function()
                Net.Place.PlaceSprinkler:Fire(pos, "Super Sprinkler", toolModel, 1)
            end)
            if DEBUG_SPRINKLER and not fired then
                warn("[SPRINKLER FIRE ERROR]", fireError, toolModel:GetFullName(), pos)
            end

            -- Chờ replication xác nhận. Không retry chỉ vì model không mang metadata "Super".
            local confirmStarted = tick()
            while tick() - confirmStarted < 1.25 do
                if IsSprinklerTargetOccupied(pos) or CountAllPlacedSprinklers() > beforeAll then
                    success = true
                    return
                end
                task.wait(0.05)
            end
        end
    end)

    SprinklerPlacing = false
    if DEBUG_SPRINKLER and not ok then
        warn("[SPRINKLER PLACE ERROR]", placeError)
    end
    return success
end

local function GetPlacedSprinklerPosition(sprinkler)
    if sprinkler:IsA("BasePart") then
        return sprinkler.Position
    end

    if sprinkler:IsA("Model") then
        if sprinkler.PrimaryPart then
            return sprinkler.PrimaryPart.Position
        end
        local ok, pivot = pcall(function()
            return sprinkler:GetPivot().Position
        end)
        if ok then return pivot end
    end

    local part = sprinkler:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function GetSprinklerSlotState(targets)
    local occupied = {false, false}
    local relevantCount = 0
    local plot = GetPlot()
    local sprinklers = plot:WaitForChild("Sprinklers")

    for _, sprinkler in ipairs(sprinklers:GetChildren()) do
        local position = GetPlacedSprinklerPosition(sprinkler)
        if position then
            local flatPosition = Vector3.new(position.X, 0, position.Z)
            local nearestSide = nil
            local nearestDistance = math.huge

            for side, target in ipairs(targets) do
                local flatTarget = Vector3.new(target.X, 0, target.Z)
                local distance = (flatPosition - flatTarget).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestSide = side
                end
            end

            -- Object ngoài bán kính vườn (ví dụ placement lỗi cũ) không chiếm slot.
            if nearestSide and nearestDistance <= SUPER_SPRINKLER_COVERAGE_RADIUS then
                relevantCount += 1
                occupied[nearestSide] = true
            end
        end
    end

    return occupied, relevantCount
end

local function PlaceSuperSprinklers()
    if tick() < NextSprinklerCheck then return end

    local targets = GetSprinklerTargetPositions()
    if #targets < MAX_SPRINKLER_TARGETS then
        NextSprinklerCheck = tick() + 1
        return
    end

    local attempted = false
    for side = 1, MAX_SPRINKLER_TARGETS do
        -- Re-read state sau mỗi placement để không bao giờ vượt quá hai sprinkler trong vùng vườn.
        local occupied, activeCount = GetSprinklerSlotState(targets)
        if activeCount >= MAX_SPRINKLER_TARGETS then
            break
        end

        if not occupied[side] then
            attempted = true
            PlaceOneSprinkler(targets[side])
            task.wait(0.10)
        end
    end

    NextSprinklerCheck = tick() + (attempted and 1.1 or 1)
end

