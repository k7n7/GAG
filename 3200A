local function GetPlantAreas()
    local Plot = GetPlot()
    local areas = {}

    for _, obj in ipairs(Plot.Visual:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("plantarea") then
            table.insert(areas, obj)
        end
    end

    table.sort(areas, function(a, b)
        local na = tonumber(a.Name:match("(%d+)$")) or 9999
        local nb = tonumber(b.Name:match("(%d+)$")) or 9999

        if na == nb then
            if math.abs(a.Position.X - b.Position.X) > 2 then
                return a.Position.X < b.Position.X
            end
            return a.Position.Z < b.Position.Z
        end

        return na < nb
    end)

    return areas
end

