--// PLOT
local function getMyPlot()
    for _, plot in ipairs(workspace.Gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                if plant:GetAttribute("UserId") == plr.UserId then
                    return plot
                end
            end
        end
    end
    return workspace.Gardens:FindFirstChild("Plot1")
end

local function getPlantArea(plot)
    return plot:FindFirstChild("PlotSizeReference")
        or plot.Visual:FindFirstChild("GardenTotalArea")
end

local function makeRay(pos)
    return Ray.new(pos + Vector3.new(0, 100, 0), Vector3.new(0, -200, 0))
end

local function countPlants(plot)
    local p = plot and plot:FindFirstChild("Plants")
    return p and #p:GetChildren() or 0
end

local function countSprinklers(plot)
    local s = plot and plot:FindFirstChild("Sprinklers")
    return s and #s:GetChildren() or 0
end

--// CLOSE SEEDSHOP
local function closeSeedShop()
    local shop = plr.PlayerGui:FindFirstChild("SeedShop")
    if shop then
        local close = shop:FindFirstChild("Close", true)
        if close and close:IsA("GuiButton") then
            pcall(function() firesignal(close.MouseButton1Click) end)
            pcall(function() firesignal(close.Activated) end)
        else
            shop.Enabled = false
        end
    end
end

local function clickGui(obj)
    if not obj then return false end
    if obj:IsA("GuiButton") then
        pcall(function() firesignal(obj.MouseButton1Click) end)
        pcall(function() firesignal(obj.Activated) end)
        return true
    end
    return false
end

