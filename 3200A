-- ===================== BUY / EXPAND =====================
local function BuyCarrotAll()
    if not AUTO_BUY_CARROT then return false end
    if tick() < NextBuyTime then return false end

    local last = CountCarrotSeeds()
    local success = false
    local fail = 0

    for _ = 1, BUY_MAX_ATTEMPTS do
        pcall(function()
            Net.SeedShop.PurchaseSeed:Fire("Carrot")
        end)
        task.wait(BUY_DELAY)

        local now = CountCarrotSeeds()
        if now > last then
            success = true
            last = now
            fail = 0
        else
            fail += 1
        end
        if fail >= 5 then break end
    end

    if not success then
        NextBuyTime = tick() + BUY_COOLDOWN
    end
    return success
end

local function ExpandPlotToMax5()
    if not AUTO_EXPAND then return end
    for _ = 1, MAX_EXPAND_LEVEL do
        pcall(function()
            Net.Actions.ExpandGarden:Fire()
        end)
        task.wait(0.45)
    end
    -- Remote có thể trả về trước khi 4 tấm đất mới replicate xong.
    -- FarmCycle ngay sau đó sẽ gọi GetPlantAreas và lập grid trên toàn bộ phần mới.
    task.wait(EXPAND_REPLICATION_WAIT)
    NextSprinklerCheck = 0
end

