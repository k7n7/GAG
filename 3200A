local function GetSuperSprinklerToolModel()
    RefreshCharacter()

    local function isSuperSprinkler(obj)
        local n = obj.Name:lower()
        return n:find("super") and n:find("sprinkler")
    end

    -- Nếu đang cầm trên tay
    for _, tool in ipairs(Character:GetChildren()) do
        if tool:IsA("Tool") and isSuperSprinkler(tool) then
            return tool
        end
    end

    -- Nếu nằm trong Backpack thì equip trước
    local Backpack = Player:WaitForChild("Backpack")

    for _, tool in ipairs(Backpack:GetChildren()) do
        if tool:IsA("Tool") and isSuperSprinkler(tool) then
            Humanoid:EquipTool(tool)
            task.wait(0.35)
            return tool
        end
    end

    -- Nếu game tạo model trong workspace[Player.Name]
    local PlayerFolder = workspace:FindFirstChild(Player.Name)
    if PlayerFolder then
        for _, obj in ipairs(PlayerFolder:GetChildren()) do
            if isSuperSprinkler(obj) then
                return obj
            end
        end
    end

    return nil
end

local function PlaceSuperSprinklers()
    if tick() < NextSprinklerCheck then
        return
    end

    local positions = GetSprinklerTargetPositions()

    for _, pos in ipairs(positions) do
        if not IsSuperSprinklerNear(pos) then
            local toolModel = GetSuperSprinklerToolModel()

            if not toolModel then
                break
            end

            local ok = pcall(function()
                Net.Place.PlaceSprinkler:Fire(
                    pos,
                    "Super Sprinkler",
                    toolModel,
                    1
                )
            end)

            if not ok then
                pcall(function()
                    SprinklerController:TryPlace(pos, "Super Sprinkler", toolModel, 1)
                end)
            end

            task.wait(0.45)
        end
    end

    NextSprinklerCheck = tick() + SPRINKLER_CHECK_COOLDOWN
end

local function IsNearGarden()
    local Plot = GetPlot()
    local Character = Player.Character or Player.CharacterAdded:Wait()
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return false end

    local Area1 = Plot.Visual:WaitForChild("PlantAreaColumn1")
    local Area2 = Plot.Visual:WaitForChild("PlantAreaColumn2")
    local Center = (Area1.Position + Area2.Position) / 2

    return (HRP.Position - Center).Magnitude < 120
end

local function TeleportGardenIfNeeded()
    if IsNearGarden() then
        --print("ALREADY NEAR GARDEN, SKIP TELEPORT")
        return
    end

    Net.TeleportButton.Request:Fire("Garden")
    task.wait(1.5)
end

-- MAIN LOGIC
local cycle = 0

local function FarmCycle()
    cycle += 1
    --print("===== FARM CYCLE:", cycle, "=====")

    SetStatus("Harvesting & Selling")
    HarvestAndSellUnder20kg()

    if cycle % EXPAND_EVERY_CYCLES == 0 then
        SetStatus("Expanding Plot")
        ExpandPlotToMax5()
    end

    local seedCount = CountCarrotSeeds()

    if seedCount <= 0 then
        SetStatus("Buying Carrot")
        BuyCarrotAll()
        task.wait(0.5)
        seedCount = CountCarrotSeeds()
    end

    SetStatus("Going Garden")
    TeleportGardenIfNeeded()

    SetStatus("Placing Sprinkler")
    PlaceSuperSprinklers()

    if seedCount > 0 then
        SetStatus("Planting Carrot")
        PlantAllCarrot(true)
    else
        SetStatus("Waiting Carrot Stock")
    end

    SetStatus("Cycle Done")
end

if RUN_FOREVER then
    while true do
        local ok, err = pcall(FarmCycle)
        if not ok then
            warn("FARM CYCLE ERROR:", err)
        end

        task.wait(LOOP_DELAY)
    end
else
    FarmCycle()
end
