local function PlantAllCarrot(alreadyAtGarden)
    if not alreadyAtGarden then
        Net.TeleportButton.Request:Fire("Garden")
        task.wait(0.8)
    end

    local seedCount = CountCarrotSeeds()
    if seedCount <= 0 then
        return
    end

    local positions = GetEmptyPlantPositions()
    if #positions <= 0 then
        return
    end

    local plantAmount = math.min(#positions, seedCount)
    local i = 1

    while i <= plantAmount do
        local CarrotTool = GetCarrotTool()
        if not CarrotTool then
            warn("Không tìm thấy Carrot để trồng tiếp.")
            break
        end

        local burstEnd = math.min(i + RAY_PLANT_BURST_SIZE - 1, plantAmount)

        for j = i, burstEnd do
            task.spawn(PlantAt, positions[j])
        end

        i = burstEnd + 1
        task.wait(RAY_PLANT_BURST_WAIT)

        if CountCarrotSeeds() <= 0 then
            break
        end
    end
end

