local function IsSuperSprinklerNear(pos)
    local Plot = GetPlot()
    local Sprinklers = Plot:WaitForChild("Sprinklers")

    local nearest = math.huge

    for _, sprinkler in ipairs(Sprinklers:GetChildren()) do
        local part =
            sprinkler.PrimaryPart
            or sprinkler:FindFirstChildWhichIsA("BasePart", true)

        if part then
            local distance = (
                Vector3.new(pos.X, 0, pos.Z)
                -
                Vector3.new(part.Position.X, 0, part.Position.Z)
            ).Magnitude

            if distance < nearest then
                nearest = distance
            end

            if distance <= SPRINKLER_CHECK_RADIUS then
                return true
            end
        end
    end

    if DEBUG_SPRINKLER then
        print("NO SPRINKLER NEAR:", pos, "nearest =", nearest, "count =", #Sprinklers:GetChildren())
    end

    return false
end

