local function PlaceSuperSprinklers()
    if tick() < NextSprinklerCheck then
        return
    end

    local positions = GetSprinklerTargetPositions()

    for _, pos in ipairs(positions) do
        if not IsSuperSprinklerNear(pos) then
            PlaceOneSprinklerConfirmed(pos)

            NextSprinklerCheck = tick() + 1.2
            return
        end
    end

    NextSprinklerCheck = tick() + SPRINKLER_CHECK_COOLDOWN
end

local function IsNearGarden()
    local Character = Player.Character or Player.CharacterAdded:Wait()
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return false end

    local areas = GetPlantAreas()
    if #areas <= 0 then
        return false
    end

    local center = Vector3.new(0, 0, 0)

    for _, area in ipairs(areas) do
        center += area.Position
    end

    center /= #areas

    return (HRP.Position - center).Magnitude < 160
end

