local function BuildPlantGrid()
    local Workspace = game:GetService("Workspace")
    local params = PlantController:CreatePlantAreaParams()
    local grid = {}
    local used = {}

    local function key(pos)
        return tostring(math.floor(pos.X + 0.5)) .. ":" .. tostring(math.floor(pos.Z + 0.5))
    end

    local areas = GetPlantAreas()

    for _, area in ipairs(areas) do
        local c, s = area.Position, area.Size

        for x = c.X - s.X/2 + PLANT_SPACING, c.X + s.X/2 - PLANT_SPACING, PLANT_SPACING do
            for z = c.Z - s.Z/2 + PLANT_SPACING, c.Z + s.Z/2 - PLANT_SPACING, PLANT_SPACING do
                local result = Workspace:Raycast(
                    Vector3.new(x, c.Y + 80, z),
                    Vector3.new(0, -200, 0),
                    params
                )

                if result then
                    local pos = result.Position
                    local k = key(pos)

                    if not used[k] then
                        used[k] = true
                        table.insert(grid, pos)
                    end
                end
            end
        end
    end

    CachedPlantGrid = grid
    CachedPlantGridAreaCount = #areas

    if DEBUG_DIRECT_PLANT then
        print("BUILD GRID:", #grid, "AREAS:", #areas)
    end

    return grid
end

local function GetEmptyPlantPositions()
    local Plot = GetPlot()
    local Plants = Plot:WaitForChild("Plants")
    local positions = {}
    local used = {}
    local occupied = {}

    for _, Plant in ipairs(Plants:GetChildren()) do
        local part =
            Plant:FindFirstChild("HarvestPart")
            or Plant.PrimaryPart
            or Plant:FindFirstChildWhichIsA("BasePart")

        if part then
            table.insert(occupied, Vector3.new(part.Position.X, 0, part.Position.Z))
        end
    end

    local function key(pos)
        return tostring(math.floor(pos.X + 0.5)) .. ":" .. tostring(math.floor(pos.Z + 0.5))
    end

    local function free(pos)
        local flat = Vector3.new(pos.X, 0, pos.Z)

        for _, p in ipairs(occupied) do
            if (flat - p).Magnitude < PLANT_SPACING then
                return false
            end
        end

        return true
    end

    for _, area in ipairs(GetPlantAreas()) do
        local center = area.Position
        local size = area.Size

        local minX = center.X - size.X / 2
        local maxX = center.X + size.X / 2
        local minZ = center.Z - size.Z / 2
        local maxZ = center.Z + size.Z / 2
        local y = center.Y

        for x = minX + PLANT_SPACING, maxX - PLANT_SPACING, PLANT_SPACING do
            for z = minZ + PLANT_SPACING, maxZ - PLANT_SPACING, PLANT_SPACING do
                local pos = Vector3.new(x, y, z)
                local k = key(pos)

                if not used[k] and free(pos) then
                    used[k] = true
                    table.insert(positions, pos)
                end
            end
        end
    end

    if DEBUG_PLANTING then
        print("EMPTY POSITIONS =", #positions, "OCCUPIED =", #occupied)
    end

    return positions
end

