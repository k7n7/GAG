local function MakeLabel(y, text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 28)
    label.Position = UDim2.new(0, 10, 0, y)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextColor3 = Color3.fromRGB(235, 235, 255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 15
    label.Text = text
    label.Parent = Main
    return label
end

local StatusLabel = MakeLabel(45, "Status: Starting")
local CarrotLabel = MakeLabel(75, "Carrot: 0")
local MoneyLabel = MakeLabel(105, "Money: ?")
local PlotLabel = MakeLabel(135, "Plot Expand: ? / 5")
local TimeLabel = MakeLabel(165, "Time: 00:00:00")

local function FormatTime(sec)
    sec = math.floor(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function SetStatus(text)
    CurrentStatus = text
    StatusLabel.Text = "Status: " .. text
end

local function RefreshCharacter()
    Character = Player.Character or Player.CharacterAdded:Wait()
    Humanoid = Character:WaitForChild("Humanoid")
end

local function GetPlot()
    for i = 1, 30 do
        local Plot = PlantController:GetPlayerPlot()
        if Plot then
            return Plot
        end
        task.wait(0.5)
    end

    error("Không tìm thấy plot sau 15 giây.")
end

local function CountCarrots()
    local Plot = GetPlot()
    local Plants = Plot:WaitForChild("Plants")

    local count = 0
    for _, Plant in ipairs(Plants:GetChildren()) do
        if Plant:GetAttribute("SeedName") == "Carrot" then
            count += 1
        end
    end

    return count
end

local function GetMoneyText()
    local leaderstats = Player:FindFirstChild("leaderstats")
    if not leaderstats then return "?" end

    for _, v in ipairs(leaderstats:GetChildren()) do
        if v:IsA("IntValue") or v:IsA("NumberValue") then
            if v.Name:lower():find("sheck") or v.Name:lower():find("money") then
                return tostring(v.Value)
            end
        end
    end

    return "?"
end

local function GetPlotExpandText()
    local Plot = GetPlot()
    local Visual = Plot:FindFirstChild("Visual")
    if not Visual then return "? / 5" end

    local TotalArea = Visual:FindFirstChild("GardenTotalArea")
    if not TotalArea then return "? / 5" end

    local sizeX = math.floor(TotalArea.Size.X)

    if sizeX >= 114 then
        return "1 / 5+"
    end

    return "? / 5"
end

local function UpdateUI()
    CarrotLabel.Text = "Carrot: " .. CountCarrots()
    MoneyLabel.Text = "Money: " .. GetMoneyText()
    PlotLabel.Text = "Plot Expand: " .. GetPlotExpandText()
    TimeLabel.Text = "Time: " .. FormatTime(tick() - StartTime)
end

task.spawn(function()
    while task.wait(1) do
        pcall(UpdateUI)
    end
end)

local function GetPlantKg(Plant)
    local HarvestPart = Plant:FindFirstChild("HarvestPart")
    if not HarvestPart then return 0 end

    local Label = HarvestPart:FindFirstChild("HarvestPromptLabel")
    if not Label then return 0 end

    local Frame = Label:FindFirstChild("Frame")
    if not Frame then return 0 end

    local NameLabel = Frame:FindFirstChild("Name")
    if not NameLabel then return 0 end

    local text = NameLabel.Text or ""
    return tonumber(text:match("([%d%.]+)kg")) or 0
end

local function HarvestAndSellUnder20kg()
    local Plot = GetPlot()
    local Plants = Plot:WaitForChild("Plants")

    for _, Plant in ipairs(Plants:GetChildren()) do
        local Ready = Plant:GetAttribute("PlantGrowthReady")
        local SeedName = Plant:GetAttribute("SeedName")
        local Kg = GetPlantKg(Plant)

        if Ready == true and Kg < MIN_KEEP_KG then
            local HarvestPart = Plant:FindFirstChild("HarvestPart")
            local Prompt = HarvestPart and HarvestPart:FindFirstChild("HarvestPrompt")

            if Prompt then
                Prompt.MaxActivationDistance = 999999
                Prompt.RequiresLineOfSight = false

                print("HARVEST:", SeedName, Kg .. "kg")
                fireproximityprompt(Prompt)
                task.wait(0.15)
            end
        elseif Ready == true then
            print("KEEP:", SeedName, Kg .. "kg")
        end
    end

    task.wait(1)
    Net.NPCS.SellAll:Fire()
    print("SELL ALL")
end

local function BuyCarrotAll()
    for i = 1, BUY_TIMES do
        Net.SeedShop.PurchaseSeed:Fire("Carrot")
        task.wait(0.08)
    end

    print("BUY CARROT DONE:", BUY_TIMES)
end

local function GetCarrotTool()
    RefreshCharacter()

    -- Nếu đang cầm Carrot sẵn
    for _, tool in ipairs(Character:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find("carrot") then
            print("CARROT ALREADY EQUIPPED:", tool.Name)
            return tool
        end
    end

    -- Nếu Carrot nằm trong Backpack
    local Backpack = Player:WaitForChild("Backpack")

    for t = 1, 30 do
        for _, tool in ipairs(Backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("carrot") then
                Humanoid:EquipTool(tool)
                print("EQUIP CARROT:", tool.Name)
                task.wait(0.7)
                return tool
            end
        end

        task.wait(0.2)
    end

    return nil
end

local function IsNearExistingPlant(pos, Plants)
    for _, Plant in ipairs(Plants:GetChildren()) do
        local part =
            Plant:FindFirstChild("HarvestPart")
            or Plant.PrimaryPart
            or Plant:FindFirstChildWhichIsA("BasePart")

        if part then
            local a = Vector3.new(pos.X, 0, pos.Z)
            local b = Vector3.new(part.Position.X, 0, part.Position.Z)

            if (a - b).Magnitude < PLANT_SPACING then
                return true
            end
        end
    end

    return false
end

local function GetPlantAreas()
    local Plot = GetPlot()
    local areas = {}

    for _, obj in ipairs(Plot.Visual:GetChildren()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("plantareacolumn") then
            table.insert(areas, obj)
        end
    end

    table.sort(areas, function(a, b)
        return a.Name < b.Name
    end)

    print("PLANT AREAS:", #areas)
    return areas
end

local function GetEmptyPlantPositions()
    local Plot = GetPlot()
    local Plants = Plot:WaitForChild("Plants")
    local positions = {}

    for _, area in ipairs(GetPlantAreas()) do
        local center = area.Position
        local size = area.Size

        local minX = center.X - size.X / 2
        local maxX = center.X + size.X / 2
        local minZ = center.Z - size.Z / 2
        local maxZ = center.Z + size.Z / 2
        local y = center.Y

        for x = minX + PLANT_SPACING, maxX - PLANT_SPACING, PLANT_SPACING do
            for z = minZ + PLANT_SPACING, maxZ - PLANT_SPACING, PLANT_SPACING do
                local pos = Vector3.new(x, y, z)

                if not IsNearExistingPlant(pos, Plants) then
                    table.insert(positions, pos)
                end
            end
        end
    end

    print("EMPTY POSITIONS:", #positions)
    return positions
end

local function PlantAt(pos)
    local origin = pos + Vector3.new(0, 80, 0)
    local direction = Vector3.new(0, -200, 0)
    local ray = Ray.new(origin, direction)

    local ok, err = pcall(function()
        PlantController:TryPlantWithRay(ray)
    end)

    print("PLANT AT:", pos, ok, err)
end

local function PlantAllCarrot(alreadyAtGarden)
    if not alreadyAtGarden then
        Net.TeleportButton.Request:Fire("Garden")
        task.wait(1.5)
    end

    local CarrotTool = GetCarrotTool()

    if not CarrotTool then
        warn("Không tìm thấy Carrot trong Backpack hoặc Character.")
        return
    end

    local positions = GetEmptyPlantPositions()

    for i, pos in ipairs(positions) do
        if i > BUY_TIMES then
            break
        end

        PlantAt(pos)
        task.wait(0.35)
    end

    print("PLANT CARROT DONE")
end

local MAX_EXPAND_LEVEL = 5

local function ExpandPlotToMax5()
    for i = 1, MAX_EXPAND_LEVEL do
        local ok, err = pcall(function()
            Net.Actions.ExpandGarden:Fire()
        end)

        print("EXPAND TRY:", i, ok, err)
        task.wait(0.6)
    end
end

local MAX_SUPER_SPRINKLER = 5
local SPRINKLER_CHECK_RADIUS = 12

local function GetSprinklerTargetPositions()
    local positions = {}

    for _, area in ipairs(GetPlantAreas()) do
        table.insert(positions, area.Position)
    end

    return positions
end

local function IsSuperSprinklerNear(pos)
    local Plot = GetPlot()
    local Sprinklers = Plot:WaitForChild("Sprinklers")

    for _, sprinkler in ipairs(Sprinklers:GetChildren()) do
        if sprinkler.Name:lower():find("super") then
            local part =
                sprinkler.PrimaryPart
                or sprinkler:FindFirstChildWhichIsA("BasePart")

            if part then
                local distance = (
                    Vector3.new(pos.X, 0, pos.Z)
                    -
                    Vector3.new(part.Position.X, 0, part.Position.Z)
                ).Magnitude

                if distance <= SPRINKLER_CHECK_RADIUS then
                    return true
                end
            end
        end
    end

    return false
end

local function CountSuperSprinklers()
    local Plot = GetPlot()
    local Sprinklers = Plot:WaitForChild("Sprinklers")

    local count = 0

    for _, sprinkler in ipairs(Sprinklers:GetChildren()) do
        if sprinkler.Name:lower():find("super") then
            count += 1
        end
    end

    return count
end

local function GetSuperSprinklerToolModel()
    RefreshCharacter()

    -- Nếu đang cầm trên tay
    for _, tool in ipairs(Character:GetChildren()) do
        if tool.Name:lower():find("super sprinkler") then
            print("SUPER SPRINKLER ALREADY EQUIPPED:", tool.Name)
            return tool
        end
    end

    -- Nếu nằm trong Backpack thì equip trước
    local Backpack = Player:WaitForChild("Backpack")

    for _, tool in ipairs(Backpack:GetChildren()) do
        if tool.Name:lower():find("super sprinkler") then
            Humanoid:EquipTool(tool)
            print("EQUIP SUPER SPRINKLER:", tool.Name)
            task.wait(0.7)
            return tool
        end
    end

    -- Nếu game tạo model trong workspace[Player.Name]
    local PlayerFolder = workspace:FindFirstChild(Player.Name)
    if PlayerFolder then
        for _, obj in ipairs(PlayerFolder:GetChildren()) do
            if obj.Name:lower():find("super sprinkler") then
                print("FOUND SUPER SPRINKLER MODEL:", obj.Name)
                return obj
            end
        end
    end

    return nil
end

local function PlaceSuperSprinklers()
    local currentCount = CountSuperSprinklers()

    if currentCount >= MAX_SUPER_SPRINKLER then
        print("SUPER SPRINKLER ĐÃ ĐỦ:", currentCount)
        return
    end

    local toolModel = GetSuperSprinklerToolModel()

    if not toolModel then
        warn("Không tìm thấy Super Sprinkler để đặt.")
        return
    end

    task.wait(0.3)

    local positions = GetSprinklerTargetPositions()

    for _, pos in ipairs(positions) do
        if CountSuperSprinklers() >= MAX_SUPER_SPRINKLER then
            break
        end

        if not IsSuperSprinklerNear(pos) then
            Net.Place.PlaceSprinkler:Fire(
                pos,
                "Super Sprinkler",
                toolModel,
                1
            )

            print("PLACE SUPER SPRINKLER:", pos)
            task.wait(0.6)
        else
            print("SKIP, ĐÃ CÓ SPRINKLER GẦN:", pos)
        end
    end
end

local function IsNearGarden()
    local Plot = GetPlot()
    local Character = Player.Character or Player.CharacterAdded:Wait()
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return false end

    local Area1 = Plot.Visual:WaitForChild("PlantAreaColumn1")
    local Area2 = Plot.Visual:WaitForChild("PlantAreaColumn2")
    local Center = (Area1.Position + Area2.Position) / 2

    return (HRP.Position - Center).Magnitude < 120
end

local function TeleportGardenIfNeeded()
    if IsNearGarden() then
        print("ALREADY NEAR GARDEN, SKIP TELEPORT")
        return
    end

    Net.TeleportButton.Request:Fire("Garden")
    task.wait(1.5)
end

-- MAIN LOGIC
local cycle = 0

local function FarmCycle()
    cycle += 1
    print("===== FARM CYCLE:", cycle, "=====")

    SetStatus("Harvesting & Selling")
    HarvestAndSellUnder20kg()

    if cycle % EXPAND_EVERY_CYCLES == 0 then
        SetStatus("Expanding Plot")
        ExpandPlotToMax5()
    end

    SetStatus("Buying Carrot")
    BuyCarrotAll()

    SetStatus("Going Garden")
    TeleportGardenIfNeeded()

    SetStatus("Placing Sprinkler")
    PlaceSuperSprinklers()

    SetStatus("Planting Carrot")
    PlantAllCarrot(true)

    SetStatus("Cycle Done")
    print("===== CYCLE DONE:", cycle, "=====")
end

if RUN_FOREVER then
    while true do
        local ok, err = pcall(FarmCycle)
        if not ok then
            warn("FARM CYCLE ERROR:", err)
        end

        task.wait(LOOP_DELAY)
    end
else
    FarmCycle()
end
