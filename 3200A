local SPRINKLER_METADATA_KEYS = {
    "ItemName", "DisplayName", "SprinklerType", "Type",
    "Variant", "ItemId", "ItemID", "Identifier"
}

local function HasSuperSprinklerMetadata(obj)
    if not obj then return false end

    local texts = {tostring(obj.Name):lower()}
    for _, key in ipairs(SPRINKLER_METADATA_KEYS) do
        local value = obj:GetAttribute(key)
        if value ~= nil then
            table.insert(texts, tostring(value):lower())
        end
    end

    for _, text in ipairs(texts) do
        if text:find("super", 1, true) and text:find("sprinkler", 1, true) then
            return true
        end
    end
    return false
end

local function IsSuperSprinklerObject(root)
    if HasSuperSprinklerMetadata(root) then return true end
    for _, obj in ipairs(root:GetDescendants()) do
        if HasSuperSprinklerMetadata(obj) then
            return true
        end
    end
    return false
end

