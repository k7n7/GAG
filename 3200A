local ReplicaController
local LocalReplica

local function GetLocalReplica()
    if LocalReplica then
        return LocalReplica
    end

    local PlotsController = require(Controllers:WaitForChild("PlotsController"))

    for _, up in ipairs(debug.getupvalues(PlotsController.Start)) do
        if type(up) == "table"
            and type(up.GetLocalReplica) == "function"
            and type(up.WaitForLocalReplica) == "function" then
            ReplicaController = up
            break
        end
    end

    assert(ReplicaController, "Không tìm thấy ReplicaController.")

    LocalReplica = ReplicaController:GetLocalReplica()

    if not LocalReplica then
        LocalReplica = ReplicaController:WaitForLocalReplica()
    end
    assert(LocalReplica, "Không tìm thấy LocalReplica.")

    return LocalReplica
end

local function CountCarrotSeeds()
    local ok, amount = pcall(function()
        local Replica = GetLocalReplica()
        local Data = Replica.Data
        local Inventory = Data.Inventory
        local Seeds = Inventory.Seeds or {}
        return tonumber(Seeds.Carrot or 0)
    end)

    if ok then
        return amount
    end

    return 0
end

local function CountCarrots()
    local Plot = GetPlot()
    local Plants = Plot:WaitForChild("Plants")

    local carrot = 0

    for _, Plant in ipairs(Plants:GetChildren()) do
        local SeedName = Plant:GetAttribute("SeedName")
        if SeedName and tostring(SeedName):lower():find("carrot") then
            carrot += 1
        end
    end

    return carrot
end

local function GetPlotExpandText()
    local Plot = GetPlot()
    local Visual = Plot:FindFirstChild("Visual")
    if not Visual then return "? / 5" end

    local TotalArea = Visual:FindFirstChild("GardenTotalArea")
    if not TotalArea then return "? / 5" end

    local x = math.floor(TotalArea.Size.X)

    if x >= 250 then return "5 / 5" end
    if x >= 210 then return "4 / 5" end
    if x >= 170 then return "3 / 5" end
    if x >= 130 then return "2 / 5" end
    if x >= 100 then return "1 / 5" end

    return "0 / 5"
end

local function GetPlantKg(Plant)
    local HarvestPart = Plant:FindFirstChild("HarvestPart")
    if not HarvestPart then return 0 end

    local Label = HarvestPart:FindFirstChild("HarvestPromptLabel")
    if not Label then return 0 end

    local Frame = Label:FindFirstChild("Frame")
    if not Frame then return 0 end

    local NameLabel = Frame:FindFirstChild("Name")
    if not NameLabel then return 0 end

    local text = NameLabel.Text or ""
    return tonumber(text:match("([%d%.]+)kg")) or 0
end

local function HarvestAndSellUnder20kg()
    local Plot = GetPlot()
    local Plants = Plot:WaitForChild("Plants")

    for _, Plant in ipairs(Plants:GetChildren()) do
        local Ready = Plant:GetAttribute("PlantGrowthReady")
        local SeedName = Plant:GetAttribute("SeedName")
        local Kg = GetPlantKg(Plant)

        if Ready == true and Kg < MIN_KEEP_KG then
            local HarvestPart = Plant:FindFirstChild("HarvestPart")
            local Prompt = HarvestPart and HarvestPart:FindFirstChild("HarvestPrompt")

            if Prompt then
                Prompt.MaxActivationDistance = 999999
                Prompt.RequiresLineOfSight = false

                print("HARVEST:", SeedName, Kg .. "kg")
                fireproximityprompt(Prompt)
                task.wait(0.15)
            end
        elseif Ready == true then
            print("KEEP:", SeedName, Kg .. "kg")
        end
    end

    task.wait(1)
    Net.NPCS.SellAll:Fire()
    print("SELL ALL")
end

local function BuyCarrotAll()
    if tick() < NextBuyTime then
        print("BUY SKIP: waiting stock")
        return false
    end

    local before = CountCarrotSeeds()

    for i = 1, BUY_TIMES do
        Net.SeedShop.PurchaseSeed:Fire("Carrot")
        task.wait(0.08)
    end

    task.wait(1)

    local after = CountCarrotSeeds()

    if after > before then
        print("BUY CARROT SUCCESS:", before, "->", after)
        return true
    end

    NextBuyTime = tick() + BUY_COOLDOWN
    print("BUY CARROT FAILED: no stock or server rejected")
    return false
end

