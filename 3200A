local MAX_SUPER_SPRINKLER = 5
local SPRINKLER_CHECK_RADIUS = 12

local function GetSprinklerTargetPositions()
    local positions = {}

    for _, area in ipairs(GetPlantAreas()) do
        table.insert(positions, area.Position)
    end

    return positions
end

local function IsSuperSprinklerNear(pos)
    local Plot = GetPlot()
    local Sprinklers = Plot:WaitForChild("Sprinklers")

    for _, sprinkler in ipairs(Sprinklers:GetChildren()) do
        if sprinkler.Name:lower():find("super") then
            local part =
                sprinkler.PrimaryPart
                or sprinkler:FindFirstChildWhichIsA("BasePart")

            if part then
                local distance = (
                    Vector3.new(pos.X, 0, pos.Z)
                    -
                    Vector3.new(part.Position.X, 0, part.Position.Z)
                ).Magnitude

                if distance <= SPRINKLER_CHECK_RADIUS then
                    return true
                end
            end
        end
    end

    return false
end

local function CountSuperSprinklers()
    local Plot = GetPlot()
    local Sprinklers = Plot:WaitForChild("Sprinklers")

    local count = 0

    for _, sprinkler in ipairs(Sprinklers:GetChildren()) do
        if sprinkler.Name:lower():find("super") then
            count += 1
        end
    end

    return count
end

