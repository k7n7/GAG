local function GetLocalReplica()
    if LocalReplica then return LocalReplica end

    local ok, PlotsController = pcall(function()
        return require(Controllers:WaitForChild("PlotsController"))
    end)
    if not ok then return nil end

    for _, up in ipairs(debug.getupvalues(PlotsController.Start)) do
        if type(up) == "table"
            and type(up.GetLocalReplica) == "function"
            and type(up.WaitForLocalReplica) == "function" then
            ReplicaController = up
            break
        end
    end

    if not ReplicaController then return nil end
    LocalReplica = ReplicaController:GetLocalReplica() or ReplicaController:WaitForLocalReplica()
    return LocalReplica
end

local function CountCarrotSeeds()
    local ok, amount = pcall(function()
        local Replica = GetLocalReplica()
        local inv = Replica and Replica.Data and Replica.Data.Inventory
        local seeds = inv and inv.Seeds or {}
        return tonumber(seeds.Carrot or 0) or 0
    end)
    return ok and amount or 0
end

local function CountCarrots()
    local plot = GetPlot()
    local plants = plot:WaitForChild("Plants")
    local count = 0
    for _, plant in ipairs(plants:GetChildren()) do
        local seed = plant:GetAttribute("SeedName")
        if seed and tostring(seed):lower():find("carrot") then
            count += 1
        end
    end
    return count
end

local function GetFruitAPI()
    if FruitAPI then return FruitAPI end

    local ok, Module = pcall(function()
        return require(Controllers:WaitForChild("PlantHoverTooltipController"))
    end)
    if not ok or type(Module) ~= "table" then return nil end

    for _, up in ipairs(debug.getupvalues(Module.Start)) do
        if type(up) == "table" and type(up.CalculatePlantWeight) == "function" then
            FruitAPI = up
            return FruitAPI
        end
