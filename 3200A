local function WaitForSuperSprinklerModel(timeout)
    timeout = timeout or 1.8
    local started = tick()

    while tick() - started < timeout do
        RefreshCharacter()

        local model = GetSuperSprinklerToolModel()
        if model then
            return model
        end

        task.wait(0.1)
    end

    return nil
end

