    for _, up in ipairs(debug.getupvalues(Module.Start)) do
        if type(up) == "table" and type(up.CalculatePlantWeight) == "function" then
            FruitAPI = up
            return FruitAPI
        end
    end

    warn("Không tìm thấy FruitAPI.CalculatePlantWeight.")
    return nil
end

local function GetHarvestPrompt(Plant)
    local HarvestPart = Plant:FindFirstChild("HarvestPart", true)

    if HarvestPart then
        return HarvestPart:FindFirstChild("HarvestPrompt")
            or HarvestPart:FindFirstChildWhichIsA("ProximityPrompt", true)
    end

    return Plant:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function GetPlantKg(Plant)
    local api = GetFruitAPI()

    if not api then
        return nil
    end

    local ok, kg = pcall(function()
        -- Test đã xác nhận: CalculatePlantWeight(Plant, Plant) trả về KG thật.
        return api.CalculatePlantWeight(Plant, Plant)
    end)

    if ok and type(kg) == "number" then
        return kg
    end

    return nil
end

local function HarvestAndSellUnder20kg()
    local Plot = GetPlot()
    local Plants = Plot:WaitForChild("Plants")

    local harvested = 0
    local checked = 0

    for _, Plant in ipairs(Plants:GetChildren()) do
        local SeedName = Plant:GetAttribute("SeedName")

        if not SeedName or not tostring(SeedName):lower():find("carrot") then
            continue
        end

        local Prompt = GetHarvestPrompt(Plant)
        if not Prompt then
            continue
        end

        local Kg = GetPlantKg(Plant)
        checked += 1

        if DEBUG_HARVEST and checked <= DEBUG_HARVEST_LIMIT then
            print("HARVEST CHECK:", SeedName, "KG =", Kg, "Plant =", Plant.Name)
        end

        -- Không đọc được KG thì bỏ qua, không harvest bừa.
        if not Kg then
            continue
        end

        -- Luật chính: >= 20kg giữ lại trong vườn.
        if Kg >= MIN_KEEP_KG then
            continue
        end

        -- Chỉ carrot < 20kg mới harvest.
        Prompt.MaxActivationDistance = 999999
        Prompt.RequiresLineOfSight = false

        fireproximityprompt(Prompt)
        harvested += 1

        task.wait(0.06)
    end

    if harvested > 0 then
        task.wait(0.15)
        Net.NPCS.SellAll:Fire()
    end
end

local function BuyCarrotAll()
    if tick() < NextBuyTime then
        return false
    end

    local before = CountCarrotSeeds()
    local lastAmount = before
    local success = false
    local failStreak = 0

    for i = 1, BUY_MAX_ATTEMPTS do
        Net.SeedShop.PurchaseSeed:Fire("Carrot")
        task.wait(BUY_DELAY)

        local now = CountCarrotSeeds()

        if now > lastAmount then
            success = true
            failStreak = 0
            lastAmount = now
        else
            failStreak += 1
        end

        if failStreak >= 5 then
            break
        end
    end

    if success then
        return true
    end

    NextBuyTime = tick() + BUY_COOLDOWN
    return false
end

