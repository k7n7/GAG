local function SnapSprinklerTarget(pos)
    local params = nil
    pcall(function()
        local created = PlantController:CreatePlantAreaParams()
        if typeof(created) == "RaycastParams" then
            params = created
        end
    end)

    local result = workspace:Raycast(
        pos + Vector3.new(0, 100, 0),
        Vector3.new(0, -250, 0),
        params
    )
    if result then
        return result.Position + Vector3.new(0, 0.15, 0)
    end
    return pos
end

local function GetSprinklerTargetPositions()
    local areas = GetPlantAreas()
    local targets = {}
    if #areas <= 0 then return targets end

    -- Dựng danh sách điểm phủ từ chính grid có thể plant, không trung bình
    -- Position của các visual part vì visual/hitbox có thể lệch giữa account.
    local params = nil
    pcall(function()
        local created = PlantController:CreatePlantAreaParams()
        if typeof(created) == "RaycastParams" then
            params = created
        end
    end)

    local points = {}
    local used = {}
    for _, area in ipairs(areas) do
        local c, s = area.Position, area.Size
        for x = c.X - s.X/2 + PLANT_SPACING, c.X + s.X/2 - PLANT_SPACING, PLANT_SPACING do
            for z = c.Z - s.Z/2 + PLANT_SPACING, c.Z + s.Z/2 - PLANT_SPACING, PLANT_SPACING do
                local result = workspace:Raycast(
                    Vector3.new(x, c.Y + 100, z),
                    Vector3.new(0, -250, 0),
                    params
                )
                if result then
                    local key = tostring(math.floor(x + 0.5)) .. ":" .. tostring(math.floor(z + 0.5))
                    if not used[key] then
                        used[key] = true
                        table.insert(points, Vector3.new(x, result.Position.Y, z))
                    end
                end
            end
        end
    end

    if #points < 2 then return targets end

    local function getObjectPosition(obj)
        if not obj then return nil end
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Model") then return obj:GetPivot().Position end

        local sum = Vector3.new(0, 0, 0)
        local count = 0
        for _, part in ipairs(obj:GetDescendants()) do
            if part:IsA("BasePart") then
                sum += part.Position
                count += 1
            end
        end
        return count > 0 and sum / count or nil
    end

    -- PlantAreaColumn1/2 cho biết hướng "hai bên" ngay cả khi plot quay 90 độ.
    local plot = GetPlot()
    local visual = plot:FindFirstChild("Visual")
    local column1 = visual and visual:FindFirstChild("PlantAreaColumn1", true)
    local column2 = visual and visual:FindFirstChild("PlantAreaColumn2", true)
    local p1, p2 = getObjectPosition(column1), getObjectPosition(column2)
    local splitX

    if p1 and p2 then
        splitX = math.abs(p2.X - p1.X) >= math.abs(p2.Z - p1.Z)
    else
        -- Fallback: trục có khoảng hở lớn nhất giữa các điểm grid.
        local function largestGap(axis)
            local values = {}
            for _, point in ipairs(points) do
                table.insert(values, axis == "X" and point.X or point.Z)
            end
            table.sort(values)
            local best = 0
            for i = 2, #values do
                best = math.max(best, values[i] - values[i - 1])
            end
            return best
        end
        splitX = largestGap("X") >= largestGap("Z")
    end

    local minValue, maxValue = math.huge, -math.huge
    for _, point in ipairs(points) do
        local value = splitX and point.X or point.Z
        minValue = math.min(minValue, value)
        maxValue = math.max(maxValue, value)
    end
    local splitValue = (minValue + maxValue) / 2

    local sums = {Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)}
    local counts = {0, 0}
    local groups = {{}, {}}
    for _, point in ipairs(points) do
        local value = splitX and point.X or point.Z
        local side = value < splitValue and 1 or 2
        sums[side] += point
        counts[side] += 1
        table.insert(groups[side], point)
    end

    for side = 1, 2 do
        if counts[side] > 0 then
            local centroid = sums[side] / counts[side]
            local closest = nil
            local closestDistance = math.huge
            for _, point in ipairs(groups[side]) do
                local distance = (Vector3.new(point.X, 0, point.Z)
                    - Vector3.new(centroid.X, 0, centroid.Z)).Magnitude
                if distance < closestDistance then
                    closest = point
                    closestDistance = distance
                end
            end
            -- Dùng grid point thật gần tâm nhất, không đặt vào khe giữa hai soil panel.
            table.insert(targets, SnapSprinklerTarget(closest or centroid))
        end
    end

    if DEBUG_SPRINKLER then
        print("[SPRINKLER TARGETS]", #targets, "POINTS", #points, "SPLIT", splitX and "X" or "Z")
        for index, target in ipairs(targets) do
            print("[SPRINKLER TARGET]", index, target)
        end
    end

    return targets
end

-- Sprinkler thường có vùng phủ nhỏ: chia từng soil panel thành các ô phủ đều.
-- Target được lấy theo CFrame thật của panel nên vẫn đúng khi plot/account bị xoay.
local function GetCheapSprinklerTargetPositions()
    local areas = GetPlantAreas()
    local targets = {}
    if #areas <= 0 then return targets end

    local params = nil
    pcall(function()
        local created = PlantController:CreatePlantAreaParams()
        if typeof(created) == "RaycastParams" then params = created end
    end)

    local candidates = {}
    for _, area in ipairs(areas) do
        local size = area.Size
        local usableX = math.max(1, size.X - 5)
        local usableZ = math.max(1, size.Z - 5)
        local countX = math.max(1, math.ceil(usableX / CHEAP_SPRINKLER_TARGET_SPACING))
        local countZ = math.max(1, math.ceil(usableZ / CHEAP_SPRINKLER_TARGET_SPACING))

        for ix = 1, countX do
            for iz = 1, countZ do
                local localX = -usableX / 2 + usableX * (ix - 0.5) / countX
                local localZ = -usableZ / 2 + usableZ * (iz - 0.5) / countZ
                local worldPoint = area.CFrame:PointToWorldSpace(Vector3.new(localX, 0, localZ))
                local result = workspace:Raycast(
                    worldPoint + Vector3.new(0, 100, 0),
                    Vector3.new(0, -250, 0),
                    params
                )
                if result then
                    table.insert(candidates, result.Position + Vector3.new(0, 0.15, 0))
                end
            end
        end
    end

    -- PlantArea có thể chồng hitbox ở mép. Gộp target gần nhau để không phí gear.
    table.sort(candidates, function(a, b)
        if math.abs(a.X - b.X) > 0.1 then return a.X < b.X end
        return a.Z < b.Z
    end)
    for _, candidate in ipairs(candidates) do
        local duplicate = false
        local flatCandidate = Vector3.new(candidate.X, 0, candidate.Z)
        for _, target in ipairs(targets) do
            if (flatCandidate - Vector3.new(target.X, 0, target.Z)).Magnitude < 6 then
                duplicate = true
                break
            end
        end
        if not duplicate then
            table.insert(targets, candidate)
            if #targets >= MAX_CHEAP_SPRINKLER_TARGETS then break end
        end
    end

    if #targets == 0 then
        targets = GetSprinklerTargetPositions()
    end
    if DEBUG_SPRINKLER then
        print("[CHEAP SPRINKLER TARGETS]", #targets)
    end
    return targets
end

local function IsSuperSprinklerNear(pos)
    local plot = GetPlot()
    local sprinklers = plot:WaitForChild("Sprinklers")

    for _, sprinkler in ipairs(sprinklers:GetChildren()) do
        -- Lỗi cũ: sprinkler thường cũng làm hàm trả true, khiến account bị skip Super Sprinkler.
        if IsSuperSprinklerObject(sprinkler) then
            local part = sprinkler.PrimaryPart or sprinkler:FindFirstChildWhichIsA("BasePart", true)
            if not part then continue end
            local a = Vector3.new(pos.X, 0, pos.Z)
            local b = Vector3.new(part.Position.X, 0, part.Position.Z)
            if (a - b).Magnitude <= SPRINKLER_RADIUS then
                return true
            end
        end
    end
    return false
end

local function IsAnyPlacedSprinklerNear(pos)
    local plot = GetPlot()
    local sprinklers = plot:WaitForChild("Sprinklers")
    local target = Vector3.new(pos.X, 0, pos.Z)

    for _, sprinkler in ipairs(sprinklers:GetChildren()) do
        -- Không phụ thuộc tên/attribute. Folder Sprinklers là trạng thái thật của plot.
        if sprinkler:IsA("BasePart") then
            local at = Vector3.new(sprinkler.Position.X, 0, sprinkler.Position.Z)
            if (target - at).Magnitude <= SPRINKLER_RADIUS then
                return true
            end
        end

        for _, part in ipairs(sprinkler:GetDescendants()) do
            if part:IsA("BasePart") then
                local at = Vector3.new(part.Position.X, 0, part.Position.Z)
                if (target - at).Magnitude <= SPRINKLER_RADIUS then
                    return true
                end
            end
        end
    end
    return false
end

local function IsSprinklerTargetOccupied(pos)
    -- Nhận diện Super nếu metadata có sẵn; fallback về bất kỳ object thật nào
    -- trong Plot.Sprinklers gần target để tuyệt đối không đặt chồng.
    return IsSuperSprinklerNear(pos) or IsAnyPlacedSprinklerNear(pos)
end

local function FindSuperSprinklerTool(root)
    if not root then return nil end

    if root:IsA("Tool") and IsSuperSprinklerObject(root) then
        return root
    end
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("Tool") and IsSuperSprinklerObject(obj) then
            return obj
        end
    end
    return nil
end

local function FindSuperSprinklerModel(root)
    if not root then return nil end

    if (root:IsA("Model") or root:IsA("Tool")) and HasSuperSprinklerMetadata(root) then
        return root
    end
    for _, obj in ipairs(root:GetDescendants()) do
        if HasSuperSprinklerMetadata(obj) then
            local candidate = obj
            while candidate and candidate ~= root do
                if candidate:IsA("Model") or candidate:IsA("Tool") then
                    return candidate
                end
                candidate = candidate.Parent
            end
        end
    end
    return nil
end

