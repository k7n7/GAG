local function GetGearStockFromUI(gearName)
    local playerGui = Player:FindFirstChild("PlayerGui")
    local gearShop = playerGui and playerGui:FindFirstChild("GearShop")
    local frame = gearShop and gearShop:FindFirstChild("Frame")
    local scrolling = frame and frame:FindFirstChild("ScrollingFrame")
    local row = scrolling and scrolling:FindFirstChild(gearName)
    if not row then return nil end

    local sawNoStock = false
    for _, object in ipairs(row:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            local stock = ParseSeedStockText(object.Text)
            if stock ~= nil then
                if stock > 0 then return stock end
                sawNoStock = true
            end
        end
    end
    return sawNoStock and 0 or nil
end

local function LooksLikeGearShopState(value)
    if type(value) ~= "table" then return false end
    local trowel = rawget(value, "Trowel")
    local sprinkler = rawget(value, "Common Sprinkler")
    return type(trowel) == "table" and type(sprinkler) == "table"
        and (rawget(sprinkler, "maxStock") ~= nil or rawget(sprinkler, "frame") ~= nil)
end

local function GetGearShopStateTable()
    if LooksLikeGearShopState(GearShopStateTable) then return GearShopStateTable end
    if type(getgc) ~= "function" then return nil end
    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then return nil end
    for _, value in ipairs(objects) do
        if LooksLikeGearShopState(value) then
            GearShopStateTable = value
            return value
        end
    end
    return nil
end

local function GetGearStock(gearName)
    local stock = GetGearStockFromUI(gearName)
    if stock ~= nil then return math.max(0, math.floor(stock)) end
    local state = GetGearShopStateTable()
    local entry = state and rawget(state, gearName)
    stock = type(entry) == "table" and tonumber(rawget(entry, "maxStock")) or nil
    return stock ~= nil and math.max(0, math.floor(stock)) or nil
end

local function GetGearRestockValue()
    local stockValues = ReplicatedStorage:FindFirstChild("StockValues")
    local gearShop = stockValues and stockValues:FindFirstChild("GearShop")
    local lastRestock = gearShop and gearShop:FindFirstChild("UnixLastRestock")
    return lastRestock and tonumber(lastRestock.Value) or nil
end

local function RefreshGearRestockState()
    local current = GetGearRestockValue()
    if current and current ~= LastGearRestockValue then
        LastGearRestockValue = current
        GearNextAttempt = {}
        GearPurchasedThisRun = {}
        GearShopStateTable = nil
        GearGlobalBackoffUntil = 0
    end
end

local function CountPurchasedGearThisRestock(gearName)
    local ok, amount = pcall(function()
        local replica = GetLocalReplica()
        local purchased = replica and replica.Data and replica.Data.PurchasedThisRestock
        local gears = purchased and purchased.Gears or {}
        return tonumber(gears[gearName] or 0) or 0
    end)
    return math.max(ok and amount or 0, GearPurchasedThisRun[gearName] or 0)
end

local function CountOwnedGearTools(gearName)
    local wanted = NormalizeItemName(gearName)
    local amount = 0
    for _, root in ipairs({Character, Player:FindFirstChild("Backpack")}) do
        if root then
            for _, object in ipairs(root:GetChildren()) do
                if object:IsA("Tool") and NormalizeItemName(object.Name):find(wanted, 1, true) then
                    local stack = 1
                    for _, key in ipairs({"Quantity", "Amount", "Count", "Uses", "Stock"}) do
                        stack = math.max(stack, tonumber(object:GetAttribute(key)) or 0)
                    end
                    amount += stack
                end
            end
        end
    end
    return amount
end

local function TryPurchaseOneGear(gearName)
    while GearPurchaseBusy do task.wait(0.02) end
    GearPurchaseBusy = true

    local stock = GetGearStock(gearName)
    if stock == nil or stock <= 0 then
        GearPurchaseBusy = false
        return false, "no_stock"
    end

    local purchasedBefore = CountPurchasedGearThisRestock(gearName)
    local ownedBefore = CountOwnedGearTools(gearName)
    local fired = pcall(function()
        Net.GearShop.PurchaseGear:Fire(gearName)
    end)

    local confirmed = false
    if fired then
        local started = tick()
        while tick() - started < SEED_BUY_CONFIRM_TIMEOUT do
            if CountPurchasedGearThisRestock(gearName) > purchasedBefore
                or CountOwnedGearTools(gearName) > ownedBefore then
                confirmed = true
                break
            end
            task.wait(0.03)
        end
    end

    GearPurchaseBusy = false
    if confirmed then
        GearPurchasedThisRun[gearName] = (GearPurchasedThisRun[gearName] or 0) + 1
    end
    return confirmed, confirmed and "purchased" or "purchase_failed"
end

local function RunGearBuyerPass()
    if not AUTO_BUY_GEARS then return end
    if tick() < GearGlobalBackoffUntil then return end
    RefreshGearRestockState()

    local names = {}
    for gearName, target in pairs(GEAR_BUY_TARGETS) do
        if (tonumber(target) or 0) > 0 then table.insert(names, gearName) end
    end
    -- Mua hai Super gear trước để không tiêu hết tiền vào gear thường rồi bỏ lỡ stock hiếm.
    local priority = {
        ["Super Sprinkler"] = 1,
        ["Super Watering Can"] = 2,
    }
    table.sort(names, function(a, b)
        local pa, pb = priority[a] or 100, priority[b] or 100
        if pa ~= pb then return pa < pb end
        return a < b
    end)

    for _, gearName in ipairs(names) do
        local target = math.max(0, tonumber(GEAR_BUY_TARGETS[gearName]) or 0)
        local bought = CountPurchasedGearThisRestock(gearName)
        local stock = GetGearStock(gearName)
        local attempts = math.min(math.max(0, target - bought), stock or 0)
        if tick() >= (GearNextAttempt[gearName] or 0) then
            for _ = 1, attempts do
                local success, reason = TryPurchaseOneGear(gearName)
                if not success then
                    -- Có stock nhưng chưa đủ tiền: thử lại có nhịp, không khóa đến tận restock sau.
                    if reason == "purchase_failed" then
                        GearGlobalBackoffUntil = tick() + 8
                        GearNextAttempt[gearName] = tick() + 8
                        return
                    end
                    break
                end
            end
        end
    end
end

local function StartGearShopBuyer()
    task.spawn(function()
        while task.wait(0.85) do pcall(RunGearBuyerPass) end
    end)
end

local function ExpandPlotToMax5()
