local function IsHarvestPrompt(prompt, plant)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    if prompt.Name:lower():find("harvest", 1, true) then return true end

    local parent = prompt.Parent
    while parent and parent ~= plant do
        if parent.Name:lower():find("harvest", 1, true) then return true end
        parent = parent.Parent
    end
    -- Fallback tương thích model cũ: plant chỉ có một prompt nhưng tên không chứa Harvest.
    local promptCount = 0
    for _, object in ipairs(plant:GetDescendants()) do
        if object:IsA("ProximityPrompt") then promptCount += 1 end
    end
    return promptCount == 1
end

local function NormalizeItemName(value)
    return tostring(value or ""):lower():gsub("[^%w]", "")
end

local function GetSeedTool(seedName, equipIfNeeded)
    RefreshCharacter()
    if equipIfNeeded == nil then equipIfNeeded = true end
    local wanted = NormalizeItemName(seedName)
    local function scoreTool(tool)
        if not tool or not tool:IsA("Tool") then return -1 end
        local normalized = NormalizeItemName(tool.Name)
        if normalized:find(wanted, 1, true) == nil then return -1 end

        local score = 10 -- fallback giống bản cũ: chỉ cần tên có "carrot"/seedName
        if normalized:find("seed", 1, true) then score += 100 end

        for _, key in ipairs({"SeedName", "ItemName", "DisplayName", "Type", "ItemType"}) do
            local value = tool:GetAttribute(key)
            if value ~= nil then
                local normalizedValue = NormalizeItemName(value)
                if normalizedValue == wanted then score += 200 end
                if normalizedValue:find("seed", 1, true) then score += 100 end
            end
        end
        return score
    end

    local bestEquipped, bestEquippedScore = nil, -1
    for _, tool in ipairs(Character:GetChildren()) do
        local score = scoreTool(tool)
        if score > bestEquippedScore then
            bestEquipped, bestEquippedScore = tool, score
        end
    end
    if bestEquipped then return bestEquipped end

    local Backpack = Player:WaitForChild("Backpack")
    local bestStored, bestStoredScore = nil, -1
    for _, tool in ipairs(Backpack:GetChildren()) do
        local score = scoreTool(tool)
        if score > bestStoredScore then
            bestStored, bestStoredScore = tool, score
        end
    end

    if bestStored and not equipIfNeeded then
        return bestStored
    end

    if bestStored then
        Humanoid:EquipTool(bestStored)
        RunService.Heartbeat:Wait()
        return bestStored
    end

    if DEBUG_PLANT then
        warn("[PLANT TOOL NOT FOUND]", seedName, "inventory", CountSeed(seedName))
        for _, tool in ipairs(Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                print("[PLANT TOOL CANDIDATE]", tool.Name, tool:GetAttributes())
            end
        end
    end
    return nil
end

