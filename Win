local WATER_SEED_VALUE = {
    ["Dragon's Breath"] = 120, ["Briar Rose"] = 118, ["Romanesco"] = 116,
    ["Moon Bloom"] = 112, ["Hypno Bloom"] = 110, ["Fire Fern"] = 108,
    ["Venom Spitter"] = 104, ["Venus Fly Trap"] = 102, ["Poison Apple"] = 100,
    ["Pomegranate"] = 98, ["Dragon Fruit"] = 92, ["Mango"] = 90,
    ["Coconut"] = 88, ["Apple"] = 82, ["Banana"] = 78,
    ["Pineapple"] = 74, ["Cactus"] = 70, ["Grape"] = 68,
}
local CachedWaterTarget = nil
local NextWaterTargetScanAt = 0
local NextWaterUseAt = 0

local function GetPlantBasePosition(plant)
    local position = nil
    if plant:IsA("Model") then
        local okPivot, pivot = pcall(function() return plant:GetPivot().Position end)
        if okPivot then position = pivot end
    elseif plant:IsA("BasePart") then
        position = plant.Position
    end
    if not position then
        local part = plant:FindFirstChildWhichIsA("BasePart", true)
        position = part and part.Position or nil
    end
    if not position then return nil end

    local params = nil
    pcall(function()
        local created = PlantController:CreatePlantAreaParams()
        if typeof(created) == "RaycastParams" then params = created end
    end)
    local hit = workspace:Raycast(
        Vector3.new(position.X, position.Y + 100, position.Z),
        Vector3.new(0, -250, 0),
        params
    )
    return hit and (hit.Position + Vector3.new(0, 0.1, 0)) or position
end

local function GetBestWaterTarget()
    if CachedWaterTarget and tick() < NextWaterTargetScanAt then return CachedWaterTarget end
    local plot = GetPlot()
    local plants = plot:FindFirstChild("Plants")
    if not plants then return nil end

    local bestPosition, bestScore = nil, -math.huge
    for _, plant in ipairs(plants:GetChildren()) do
        local position = GetPlantBasePosition(plant)
        if position then
            local seedName = tostring(plant:GetAttribute("SeedName") or "")
            local rarityScore = WATER_SEED_VALUE[seedName] or 10
            local kg = GetPlantKg(plant)
            local sizeScore = 0
            if plant:IsA("Model") then
                local okSize, size = pcall(function() return plant:GetExtentsSize() end)
                if okSize then sizeScore = size.Magnitude end
            end
            local score = rarityScore * 100000 + (ValidKg(kg) and kg or 0) * 1000 + sizeScore
            if score > bestScore then
                bestScore = score
                bestPosition = position
            end
        end
    end
    CachedWaterTarget = bestPosition
    NextWaterTargetScanAt = tick() + 0.8
    return bestPosition
end

local function UseOneCommonWateringCan()
    if not AUTO_USE_COMMON_WATERING then return false end
    if tick() < NextWaterUseAt then return false end
    if PlantingActive or SprinklerPlacing or SprinklerRequested or WateringActive then return false end

    WateringRequested = true
    while PlantingActive or SprinklerPlacing or SprinklerRequested do task.wait(0.02) end
    WateringActive = true
    WateringRequested = false

    local success = false
    local ok, err = pcall(function()
        RefreshCharacter()
        local backpack = Player:WaitForChild("Backpack")
        local target = GetBestWaterTarget()
        if not target then return end

        local tool = FindGearObject(Character, "Common Watering Can", true)
            or FindGearObject(backpack, "Common Watering Can", true)
        if not tool then return end
        local ownedBefore = CountOwnedGearTools("Common Watering Can")

        for _, equipped in ipairs(Character:GetChildren()) do
            if equipped:IsA("Tool") and equipped ~= tool then equipped.Parent = backpack end
        end
        if not tool:IsDescendantOf(Character) then
            tool.Parent = Character
            RunService.Heartbeat:Wait()
        end

        local fired = pcall(function()
            EnsureNearActionPosition(target, WATER_SERVER_RANGE)
            Net.WateringCan.UseWateringCan:Fire(target, "Common Watering Can", tool)
        end)
        task.wait(0.12)
        success = fired and CountOwnedGearTools("Common Watering Can") < ownedBefore
        NextWaterUseAt = tick() + (success and 0.08 or 0.8)
    end)

    WateringActive = false
    WateringRequested = false
    if not ok and DEBUG then warn("WATERING ERROR:", err) end
    return success
end

