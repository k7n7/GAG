local function IsNearGarden()
    RefreshCharacter()
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local areas = GetPlantAreas()
    if #areas <= 0 then return false end

    local center = Vector3.new(0, 0, 0)
    for _, area in ipairs(areas) do
        center += area.Position
    end
    center /= #areas

    return (hrp.Position - center).Magnitude < 180
end

local function TeleportGardenIfNeeded()
    if IsNearGarden() then return end
    pcall(function()
        Net.TeleportButton.Request:Fire("Garden")
    end)
    task.wait(0.9)
end

local function StartPlantWorker()
    task.spawn(function()
        while task.wait(PLANT_WORKER_DELAY) do
            if not PlantingActive and tick() >= NextPlantWorkerAttemptAt then
                NextPlantWorkerAttemptAt = tick() + 0.12
                if HasConfiguredSeedToPlant() then
                    local ok, err = pcall(function()
                        TeleportGardenIfNeeded()
                        local planted = PlantConfiguredSeeds(true)
                        if not planted and CountCarrotSeeds() > 0
                            and tick() >= (PlantSeedNextAttempt.Carrot or 0) then
                            PlantSeedNextAttempt.Carrot = tick() + 0.75
                            PlantCarrotLegacyFallback()
                        end
                        NextPlantWorkerAttemptAt = tick() + (planted and 0.015 or 0.14)
                    end)
                    if not ok then
                        NextPlantWorkerAttemptAt = tick() + 0.20
                        warn("PLANT WORKER ERROR:", err)
                    end
                end
            end
        end
    end)
end

