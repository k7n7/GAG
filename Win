local function WaitForSuperSprinklerModel(timeout)
    timeout = timeout or 1.6
    local started = tick()

    while tick() - started < timeout do
        RefreshCharacter()

        -- Ưu tiên Tool đang equip.
        local equipped = FindSuperSprinklerTool(Character)
        if equipped then
            return equipped
        end

        local backpack = Player:FindFirstChild("Backpack")
        local storedTool = FindSuperSprinklerTool(backpack)
        if storedTool then
            pcall(function()
                Humanoid:EquipTool(storedTool)
            end)
            task.wait(0.12)
            return FindSuperSprinklerTool(Character) or storedTool
        end

        -- Một số account/build tạo placement model lồng sâu trong workspace.<PlayerName>.
        local playerFolder = workspace:FindFirstChild(Player.Name)
        local placementModel = FindSuperSprinklerModel(playerFolder)
        if placementModel then
            return placementModel
        end

        task.wait(0.08)
    end

    DumpSprinklerCandidates()
    return nil
end

local function ObjectMatchesGearName(object, gearName)
    if not object then return false end
    local wanted = NormalizeItemName(gearName)
    if NormalizeItemName(object.Name):find(wanted, 1, true) then return true end
    for _, key in ipairs(SPRINKLER_METADATA_KEYS) do
        local value = object:GetAttribute(key)
        if value and NormalizeItemName(value):find(wanted, 1, true) then return true end
    end
    return false
end

local function FindGearObject(root, gearName, toolsOnly)
    if not root then return nil end
    if (not toolsOnly or root:IsA("Tool")) and ObjectMatchesGearName(root, gearName) then
        return root
    end
    for _, object in ipairs(root:GetDescendants()) do
        if (not toolsOnly or object:IsA("Tool")) and ObjectMatchesGearName(object, gearName) then
            return object
        end
    end
    return nil
end

local function WaitForPreferredSprinklerModel(timeout)
    local started = tick()
    while tick() - started < timeout do
        RefreshCharacter()
        local backpack = Player:FindFirstChild("Backpack")

        for _, gearName in ipairs(GEARS_TO_USE) do
            if string.lower(gearName) == "super sprinkler" then continue end
            local equipped = FindGearObject(Character, gearName, true)
            if equipped then return equipped, gearName end

            local stored = FindGearObject(backpack, gearName, true)
            if stored then
                -- Direct parent giống Plant/Watering: không chạy animation EquipTool.
                for _, equippedTool in ipairs(Character:GetChildren()) do
                    if equippedTool:IsA("Tool") and equippedTool ~= stored then
                        equippedTool.Parent = backpack
                    end
                end
                stored.Parent = Character
                RunService.Heartbeat:Wait()
                return FindGearObject(Character, gearName, true) or stored, gearName
            end
        end

        local playerFolder = workspace:FindFirstChild(Player.Name)
        for _, gearName in ipairs(GEARS_TO_USE) do
            if string.lower(gearName) == "super sprinkler" then continue end
            local placementModel = FindGearObject(playerFolder, gearName, false)
            if placementModel then return placementModel, gearName end
        end
        task.wait(0.08)
    end

    -- Không fallback sang Super Sprinkler: đây là khóa an toàn theo config V20.
    return nil, nil
end

local function PlaceOneSprinkler(pos)
    -- Chờ plant nhả Carrot tool; đồng thời chặn hai sprinkler worker chạy trùng nhau.
    SprinklerRequested = true
    while PlantingActive or SprinklerPlacing or WateringActive do
        task.wait(0.03)
    end
    SprinklerPlacing = true
    SprinklerRequested = false

    local success = false
    local ok, placeError = pcall(function()
        for _ = 1, 3 do
            -- Kiểm tra lại ngay trước mỗi attempt; worker khác hoặc sprinkler cũ có thể đã chiếm target.
            if IsSprinklerTargetOccupied(pos) then
                success = true
                return
            end

            local beforeAll = CountAllPlacedSprinklers()
            local toolModel, gearName = WaitForPreferredSprinklerModel(0.55)
            if not toolModel then return end

            local fired, fireError = pcall(function()
                Net.Place.PlaceSprinkler:Fire(pos, gearName, toolModel, 1)
            end)
            if DEBUG_SPRINKLER and not fired then
                warn("[SPRINKLER FIRE ERROR]", fireError, toolModel:GetFullName(), pos)
            end

            -- Chờ replication xác nhận. Không retry chỉ vì model không mang metadata "Super".
            local confirmStarted = tick()
            while tick() - confirmStarted < 1.25 do
                if IsSprinklerTargetOccupied(pos) or CountAllPlacedSprinklers() > beforeAll then
                    success = true
                    return
                end
                task.wait(0.05)
            end
        end
    end)

    SprinklerPlacing = false
    SprinklerRequested = false
    if DEBUG_SPRINKLER and not ok then
        warn("[SPRINKLER PLACE ERROR]", placeError)
    end
    return success
end

local function GetPlacedSprinklerPosition(sprinkler)
    if sprinkler:IsA("BasePart") then
        return sprinkler.Position
    end

    if sprinkler:IsA("Model") then
        if sprinkler.PrimaryPart then
            return sprinkler.PrimaryPart.Position
        end
        local ok, pivot = pcall(function()
            return sprinkler:GetPivot().Position
        end)
        if ok then return pivot end
    end

    local part = sprinkler:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function PlaceCheapSprinklers()
    if tick() < NextSprinklerCheck then return end

    local targets = GetCheapSprinklerTargetPositions()
    if #targets <= 0 then
        NextSprinklerCheck = tick() + 1
        return
    end

    local attempted = false
    for _, target in ipairs(targets) do
        -- Mỗi điểm lưới chỉ có một vòi. Khi vòi hết hạn object biến mất và slot được bù ngay.
        if not IsSprinklerTargetOccupied(target) then
            attempted = true
            local placed = PlaceOneSprinkler(target)
            if not placed then
                -- Hết gear hoặc server từ chối: dừng pass để không chờ 0.55s ở mọi target trống.
                break
            end
            task.wait(0.06)
        end
    end

    NextSprinklerCheck = tick() + (attempted and 0.55 or 0.9)
end

