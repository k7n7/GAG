-- ===================== PLANT AREAS / GRID =====================
local function GetPlantAreas()
    if CachedPlantAreas and tick() < PlantAreasCacheUntil then return CachedPlantAreas end
    local plot = GetPlot()
    local areas = {}
    local seen = {}
    local positionKeys = {}
    local plantsFolder = plot:FindFirstChild("Plants")
    local sprinklersFolder = plot:FindFirstChild("Sprinklers")

    -- Dùng chính RaycastParams của PlantController để xác nhận mặt có thể plant.
    -- Params được tạo lại mỗi lần quét nên tự nhận các phần mở rộng trong tương lai.
    local plantAreaParams = nil
    pcall(function()
        local params = PlantController:CreatePlantAreaParams()
        if typeof(params) == "RaycastParams" then
            plantAreaParams = params
        end
    end)

    local function rayHitsPlantArea(obj)
        if not plantAreaParams then return true end
        local result = workspace:Raycast(
            obj.Position + Vector3.new(0, 100, 0),
            Vector3.new(0, -250, 0),
            plantAreaParams
        )
        return result ~= nil
    end

    local function add(obj, trustedPlantArea)
        if not obj or not obj:IsA("BasePart") or seen[obj] then return end

        if plantsFolder and obj:IsDescendantOf(plantsFolder) then return end
        if sprinklersFolder and obj:IsDescendantOf(sprinklersFolder) then return end

        -- Loại viền, cọc, particle part...; chỉ giữ mặt đất ngang đủ lớn để có grid.
        if obj.Size.X < PLANT_SPACING * 1.5 or obj.Size.Z < PLANT_SPACING * 1.5 then return end
        if math.abs(obj.CFrame.UpVector.Y) < 0.75 then return end
        if not trustedPlantArea and not rayHitsPlantArea(obj) then return end

        seen[obj] = true

        -- Nhiều plot có cả soil visual và hitbox trùng tâm. Chỉ lập grid một lần.
        local k = tostring(math.floor(obj.Position.X * 2 + 0.5))
            .. ":" .. tostring(math.floor(obj.Position.Z * 2 + 0.5))
        if positionKeys[k] then return end
        positionKeys[k] = true
        table.insert(areas, obj)
    end

    -- Nguồn chính: mọi descendant trong PlantAreaColumn1/2. Sau expand, các dải đất con
    -- thường không mang tên PlantArea và ray params cũ có thể chưa nhận chúng.
    local visual = plot:FindFirstChild("Visual")
    if visual then
        for _, container in ipairs(visual:GetDescendants()) do
            if container.Name:lower():find("plantarea", 1, true) then
                add(container, true)
                for _, obj in ipairs(container:GetDescendants()) do
                    if obj:IsA("BasePart") then add(obj, true) end
                end
            end
        end
    end

    -- Fallback cho layout khác tên: kiểm tra các mặt ngang lớn bằng plant-area raycast.
    for _, obj in ipairs(plot:GetDescendants()) do
        if obj:IsA("BasePart") then
            add(obj, false)
        end
    end

    table.sort(areas, function(a, b)
        if math.abs(a.Position.X - b.Position.X) > 2 then
            return a.Position.X < b.Position.X
        end
        return a.Position.Z < b.Position.Z
    end)

    if (DEBUG or DEBUG_EXPAND_PATHS) and #areas ~= LastPlantAreaCount then
        LastPlantAreaCount = #areas
        print("[GRID] Plant areas detected:", #areas)
        if DEBUG_EXPAND_PATHS then
            for index, area in ipairs(areas) do
                print("[GRID AREA]", index, area:GetFullName(), "SIZE", area.Size, "POS", area.Position)
            end
        end
    end

    CachedPlantAreas = areas
    PlantAreasCacheUntil = tick() + 0.50
    return areas
end

local function IsPersistentSeed(seedName)
    return seedName ~= nil and PERSISTENT_SEEDS[tostring(seedName)] == true
end

local function GetGearReserveCenters(positions)
    if not RESERVE_GEAR_CENTERS or #positions < 2 then return {} end

    local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
    for _, pos in ipairs(positions) do
        minX, maxX = math.min(minX, pos.X), math.max(maxX, pos.X)
        minZ, maxZ = math.min(minZ, pos.Z), math.max(maxZ, pos.Z)
    end

    -- Chia vườn thành hai luống theo trục có biên độ lớn nhất rồi lấy tâm thật của từng luống.
    local splitByX = (maxX - minX) >= (maxZ - minZ)
    local middle = splitByX and ((minX + maxX) / 2) or ((minZ + maxZ) / 2)
    local sums = {Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)}
    local counts = {0, 0}

    for _, pos in ipairs(positions) do
        local coordinate = splitByX and pos.X or pos.Z
        local side = coordinate <= middle and 1 or 2
        sums[side] += pos
        counts[side] += 1
    end

    local centers = {}
    for side = 1, 2 do
        if counts[side] > 0 then
            table.insert(centers, sums[side] / counts[side])
        end
    end
    return centers
end

local function SortPlantPositions(positions, seedName)
    local persistent = IsPersistentSeed(seedName)
    table.sort(positions, function(a, b)
        -- Hai nhóm đi từ hai đầu đối diện nhau để cây lâu năm không xen lẫn cây quay vòng nhanh.
        if math.abs(a.Z - b.Z) > 0.25 then
            if persistent then return a.Z > b.Z end
            return a.Z < b.Z
        end
        if math.abs(a.X - b.X) > 0.25 then
            return a.X < b.X
        end
        return a.Y < b.Y
    end)
end

local function GetEmptyPlantPositions(seedName)
    local plot = GetPlot()
    local plants = plot:WaitForChild("Plants")
    local positions = {}
    local candidates = {}
    local occupied = {}
    local used = {}
    local plantAreaParams = nil

    pcall(function()
        local params = PlantController:CreatePlantAreaParams()
        if typeof(params) == "RaycastParams" then
            plantAreaParams = params
        end
    end)

    for _, plant in ipairs(plants:GetChildren()) do
        -- HarvestPart có thể là trái nằm xa gốc; dùng pivot/root để không đánh dấu sai ô trống.
        local position = nil
        if plant:IsA("Model") then
            local okPivot, pivot = pcall(function() return plant:GetPivot().Position end)
            if okPivot then position = pivot end
        elseif plant:IsA("BasePart") then
            position = plant.Position
        end
        if not position then
            local part = (plant:IsA("Model") and plant.PrimaryPart)
                or plant:FindFirstChildWhichIsA("BasePart", true)
            position = part and part.Position or nil
        end
        if position then
            table.insert(occupied, Vector3.new(position.X, 0, position.Z))
        end
    end

    local function key(pos)
        return tostring(math.floor(pos.X + 0.5)) .. ":" .. tostring(math.floor(pos.Z + 0.5))
    end

    local requiredSpacing = IsPersistentSeed(seedName) and PERSISTENT_PLANT_SPACING or PLANT_SPACING
    local function free(pos, accepted)
        local flat = Vector3.new(pos.X, 0, pos.Z)
        for _, p in ipairs(occupied) do
            if (flat - p).Magnitude < requiredSpacing then
                return false
            end
        end
        for _, p in ipairs(accepted or {}) do
            if (flat - p).Magnitude < requiredSpacing then return false end
        end
        return true
    end

    local function snapToPlantArea(pos, fallbackSurfaceY)
        if not plantAreaParams then return pos end
        local result = workspace:Raycast(
            pos + Vector3.new(0, 100, 0),
            Vector3.new(0, -250, 0),
            plantAreaParams
        )
        -- Expanded strips can replicate before PlantController refreshes its cached params.
        if not result then return Vector3.new(pos.X, fallbackSurfaceY or pos.Y, pos.Z) end
        return Vector3.new(pos.X, result.Position.Y, pos.Z)
    end

    local plotPivot = plot:IsA("Model") and plot:GetPivot().Position or plot.Position
    for _, area in ipairs(GetPlantAreas()) do
        local c, s = area.Position, area.Size
        -- Mọi tấm đất dùng chung một anchor của plot: expand thêm part vẫn thẳng hàng cũ.
        local minX = c.X - s.X / 2 + PLANT_SPACING
        local maxX = c.X + s.X / 2 - PLANT_SPACING
        local minZ = c.Z - s.Z / 2 + PLANT_SPACING
        local maxZ = c.Z + s.Z / 2 - PLANT_SPACING
        local startX = plotPivot.X + math.ceil((minX - plotPivot.X) / PLANT_SPACING) * PLANT_SPACING
        local startZ = plotPivot.Z + math.ceil((minZ - plotPivot.Z) / PLANT_SPACING) * PLANT_SPACING
        for x = startX, maxX + 0.01, PLANT_SPACING do
            for z = startZ, maxZ + 0.01, PLANT_SPACING do
                local pos = snapToPlantArea(Vector3.new(x, c.Y, z), c.Y + s.Y / 2)
                local k = pos and key(pos) or nil
                if pos and not used[k] then
                    used[k] = true
                    table.insert(candidates, pos)
                end
            end
        end
    end

    local reserveCenters = GetGearReserveCenters(candidates)
    SortPlantPositions(candidates, seedName)
    local acceptedFlat = {}
    for _, pos in ipairs(candidates) do
        local reserved = false
        for _, center in ipairs(reserveCenters) do
            local delta = Vector3.new(pos.X - center.X, 0, pos.Z - center.Z)
            if delta.Magnitude < GEAR_RESERVE_RADIUS then
                reserved = true
                break
            end
        end

        if not reserved and free(pos, acceptedFlat) then
            table.insert(positions, pos)
            table.insert(acceptedFlat, Vector3.new(pos.X, 0, pos.Z))
        end
    end

    return positions
end

local function PlantAt(pos)
    -- Fallback tương thích nếu server/account từ chối direct no-equip.
    -- Bắn từ trên xuống để không cần xoay camera/tele từng cây.
    EnsureNearActionPosition(pos, PLANT_SERVER_RANGE)
    local ray = Ray.new(pos + Vector3.new(0, 80, 0), Vector3.new(0, -200, 0))
    local ok = pcall(function()
        PlantController:TryPlantWithRay(ray)
    end)
    return ok
end

local function WaitForPlantConfirmation(seedName, inventoryBefore, plantCountBefore, timeout)
    local started = tick()
    while tick() - started < timeout do
        if CountSeed(seedName) < inventoryBefore or CountPlotPlants() > plantCountBefore then
            return true
        end
        task.wait(0.015)
    end
    return false
end

local function TryDirectPlantBatch(seedName, positions, amount)
    if not AUTO_DIRECT_PLANT or amount <= 0 or tick() < DirectPlantBackoffUntil then
        return false
    end

    RefreshCharacter()
    local backpack = Player:WaitForChild("Backpack")

    -- Capture chứng minh server nhận Tool trong Character. Di chuyển parent trực tiếp
    -- để bỏ animation/debounce Humanoid:EquipTool và không để nhiều seed Tool cùng equipped.
    for _, equipped in ipairs(Character:GetChildren()) do
        if equipped:IsA("Tool") then equipped.Parent = backpack end
    end

    local tool = GetSeedTool(seedName, false)
    if not tool then return false end
    tool.Parent = Character
    RunService.Heartbeat:Wait() -- cho trạng thái Character replicate trước packet đầu

    local firedAny = false
    for index = 1, amount do
        if not tool.Parent then
            tool = GetSeedTool(seedName, false)
            if not tool then break end
            tool.Parent = Character
            RunService.Heartbeat:Wait()
        end

        -- Các điểm đã sort liền nhau: chỉ teleport khi batch đi sang vùng ngoài bán kính an toàn.
        EnsureNearActionPosition(positions[index], PLANT_SERVER_RANGE)
        local fired = pcall(function()
            Net.Plant.PlantSeed:Fire(positions[index], seedName, tool)
        end)
        firedAny = firedAny or fired
        if not fired then break end
        if index % DIRECT_PLANT_CALLS_PER_HEARTBEAT == 0 then
            RunService.Heartbeat:Wait()
        end
    end
    return firedAny
end

local function GetConfiguredPlantOrder()
    local names = {}
    local inventory = {}
    for seedName, limit in pairs(SEED_PLANT_LIMITS) do
        if (tonumber(limit) or 0) > 0 then
            table.insert(names, seedName)
            inventory[seedName] = CountSeed(seedName)
        end
    end

    -- Xả seed đang có số lượng lớn trước để lấp nhiều ô bằng một Tool, giảm đổi equip.
    -- Carrot vẫn là filler cuối cùng để không chiếm slot của seed khác.
    table.sort(names, function(a, b)
        if a == b then return false end
        if a == "Carrot" then return false end
        if b == "Carrot" then return true end
        if inventory[a] ~= inventory[b] then return inventory[a] > inventory[b] end
        return a < b
    end)
    return names
end

local function HasConfiguredSeedToPlant()
    if not AUTO_PLANT_SEEDS then return false end
    for seedName, limit in pairs(SEED_PLANT_LIMITS) do
        -- Inventory replica rẻ hơn scan toàn bộ Plants; seed = 0 không được phép dựng grid/đếm plant.
        if CountSeed(seedName) > 0 then
            local remaining = (tonumber(limit) or 0) - CountPlantedSeed(seedName)
            if remaining > 0 then return true end
        end
    end
    return false
end

local function PlantConfiguredSeeds(alreadyAtGarden)
    if not AUTO_PLANT_SEEDS then return false end
    if not alreadyAtGarden then
        pcall(function() Net.TeleportButton.Request:Fire("Garden") end)
        task.wait(0.4)
    end

    -- Không cho seed tool thay thế Super Sprinkler trong lúc placement đang chạy.
    while SprinklerPlacing or SprinklerRequested or WateringActive or WateringRequested do
        task.wait(0.02)
    end
    PlantingActive = true
    local anyConfirmed = false

    local ok, err = pcall(function()
        for pass = 1, PLANT_RESCAN_PASSES do
            local madeProgress = false
            for _, seedName in ipairs(GetConfiguredPlantOrder()) do
                if tick() < (PlantSeedNextAttempt[seedName] or 0) then continue end

                local limit = tonumber(SEED_PLANT_LIMITS[seedName]) or 0
                local inventoryBefore = CountSeed(seedName)
                if inventoryBefore <= 0 or limit <= 0 then continue end

                local plantedBefore = CountPlantedSeed(seedName)
                local quotaRemaining = math.max(0, limit - plantedBefore)
                if quotaRemaining <= 0 then continue end

                local positions = GetEmptyPlantPositions(seedName)
                if #positions <= 0 then
                    PlantSeedNextAttempt[seedName] = tick() + 0.40
                    continue
                end
                local batchLimit = seedName == "Carrot" and #positions or PLANT_PER_SEED_PER_PASS
                local amount = math.min(#positions, quotaRemaining, inventoryBefore, batchLimit)

                if amount > 0 then
                    local plantCountBefore = CountPlotPlants()
                    local usedDirect = TryDirectPlantBatch(seedName, positions, amount)

                    if not usedDirect then
                        if not GetSeedTool(seedName) then continue end
                        for i = 1, amount do
                            PlantAt(positions[i])
                            task.wait(PLANT_RAY_INTERVAL)
                        end
                    end

                    task.wait(PLANT_RESCAN_WAIT)
                    local inventoryAfter = CountSeed(seedName)
                    local plantCountAfter = CountPlotPlants()
                    local consumed = math.max(0, inventoryBefore - inventoryAfter)
                    local created = math.max(0, plantCountAfter - plantCountBefore)
                    local confirmed = math.min(amount, math.max(consumed, created))

                    if confirmed > 0 then
                        DirectPlantFailureStreak = 0
                        PlantSeedNextAttempt[seedName] = nil
                        madeProgress = true
                        anyConfirmed = true
                    else
                        if usedDirect then
                            DirectPlantFailureStreak += 1
                            if DirectPlantFailureStreak >= 2 then
                                -- Direct không tạo cây ở hai batch liên tiếp: cho Ray một cửa sổ ngắn,
                                -- sau đó tự thử Direct lại; không bao giờ disable vĩnh viễn.
                                DirectPlantBackoffUntil = tick() + 0.8
                                DirectPlantFailureStreak = 0
                            end
                        end
                        PlantSeedNextAttempt[seedName] = tick() + 0.18
                    end
                end
            end

            if not madeProgress then return end
            if pass < PLANT_RESCAN_PASSES then task.wait(PLANT_RESCAN_WAIT) end
        end
    end)

    PlantingActive = false
    if not ok then
        error(err)
    end
    return anyConfirmed
end

local function PlantCarrotLegacyFallback()
    if CountCarrotSeeds() <= 0 then return false end

    while SprinklerPlacing or WateringActive do task.wait(0.02) end
    PlantingActive = true
    local planted = false

    local ok, err = pcall(function()
        for pass = 1, PLANT_RESCAN_PASSES do
            local seedCount = CountCarrotSeeds()
            if seedCount <= 0 then return end
            if not GetCarrotToolLegacy() then return end

            local positions = GetEmptyPlantPositions("Carrot")
            if #positions <= 0 then return end

            local amount = math.min(#positions, seedCount)
            for i = 1, amount do
                PlantAt(positions[i])
                task.wait(PLANT_RAY_INTERVAL)
            end
            planted = true
            if pass < PLANT_RESCAN_PASSES then task.wait(PLANT_RESCAN_WAIT) end
        end
    end)

    PlantingActive = false
    if not ok then error(err) end
    return planted
end

-- ===================== HARVEST + SELL =====================
-- Mỗi plant chỉ có một watcher. Các watcher chạy song song, nên 30 cây cùng chín
-- sẽ được bắn prompt trong cùng khung thời gian, không chờ FarmCycle quét tuần tự.
local HarvestWatchers = setmetatable({}, {__mode = "k"})
local HarvestPromptWatchers = setmetatable({}, {__mode = "k"})

local function ValidKg(value)
    return type(value) == "number" and value == value and value >= 0
end

-- Nếu UI label tồn tại, dùng nó làm lớp kiểm tra thứ hai độc lập với FruitAPI.
-- Trả về: kg, labelExists. Label có nhưng chưa parse được => fail-closed.
local function GetPlantLabelKg(plant)
    local labelRoot = plant:FindFirstChild("HarvestPromptLabel", true)
    if not labelRoot then return nil, false end

    for _, obj in ipairs(labelRoot:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local text = tostring(obj.Text or ""):lower()
            local parsed = text:match("([%d%.]+)%s*kg")
            local kg = parsed and tonumber(parsed) or nil
            if ValidKg(kg) then
                return kg, true
            end
        end
    end

    return nil, true
end

local function IsDefinitelySafeToHarvest(plant)
    -- Không cache. Luôn lấy giá trị mới ngay trước thời điểm harvest.
    local kg1 = GetPlantKg(plant)
    local labelKg1, labelExists1 = GetPlantLabelKg(plant)

    if not ValidKg(kg1) then return false, false end
    if labelExists1 and not ValidKg(labelKg1) then return false, false end
    if kg1 >= MIN_KEEP_KG or (labelKg1 and labelKg1 >= MIN_KEEP_KG) then
        return false, true
    end

    if HARVEST_DOUBLE_CHECK then
        RunService.Heartbeat:Wait()
        if not plant.Parent then return false, false end

        local kg2 = GetPlantKg(plant)
        local labelKg2, labelExists2 = GetPlantLabelKg(plant)
        if not ValidKg(kg2) then return false, false end
        if labelExists2 and not ValidKg(labelKg2) then return false, false end
        if kg2 >= MIN_KEEP_KG or (labelKg2 and labelKg2 >= MIN_KEEP_KG) then
            return false, true
        end
    end

    return true, false
end

local function WatchHarvestPrompt(plant, prompt)
    if not IsHarvestPrompt(prompt, plant) or HarvestPromptWatchers[prompt] then return end

    local state = {busy = false, connections = {}}
    HarvestPromptWatchers[prompt] = state

    local function stop()
        for _, connection in ipairs(state.connections) do
            pcall(function() connection:Disconnect() end)
        end
        state.connections = {}
        HarvestPromptWatchers[prompt] = nil
    end

    local function runWhileEnabled()
        if state.busy or not prompt.Parent or not prompt.Enabled then return end
        state.busy = true

        task.spawn(function()
            local fastAttempts = 0
            local sellQueued = false
            while plant.Parent and prompt.Parent and prompt.Enabled do
                local seed = plant:GetAttribute("SeedName")
                local seedName = seed and tostring(seed) or nil
                if seedName and (tonumber(SEED_PLANT_LIMITS[seedName]) or 0) > 0 then
                    local safe, protected = true, false
                    if PROTECT_PLANT_BY_KG then
                        safe, protected = IsDefinitelySafeToHarvest(plant)
                    end
                    if protected then break end

                    if safe and prompt.Parent and prompt.Enabled then
                        local fired = pcall(function()
                            prompt.MaxActivationDistance = 999999
                            prompt.RequiresLineOfSight = false
                            fireproximityprompt(prompt)
                        end)
                        if fired then
                            LastHarvestAttemptAt = tick()
                            if not sellQueued then
                                HarvestAttemptsSinceSell += 1
                                sellQueued = true
                            end
                        end
                        fastAttempts += 1
                        task.wait(fastAttempts < HARVEST_FAST_RETRIES
                            and HARVEST_RETRY_WAIT or HARVEST_IDLE_RETRY)
                    else
                        task.wait(HARVEST_POLL_INTERVAL)
                    end
                else
                    -- Attribute SeedName thường replicate ngay sau model/prompt.
                    task.wait(HARVEST_POLL_INTERVAL)
                end
            end
            state.busy = false
        end)
    end

    table.insert(state.connections, prompt:GetPropertyChangedSignal("Enabled"):Connect(runWhileEnabled))
    table.insert(state.connections, prompt.AncestryChanged:Connect(function()
        if not prompt:IsDescendantOf(plant) then stop() end
    end))
    runWhileEnabled()
end

local function WatchHarvestPlant(plant)
    if HarvestWatchers[plant] then return end
    HarvestWatchers[plant] = true

    for _, object in ipairs(plant:GetDescendants()) do
        if object:IsA("ProximityPrompt") then
            WatchHarvestPrompt(plant, object)
        end
    end

    local descendantConnection = plant.DescendantAdded:Connect(function(object)
        if object:IsA("ProximityPrompt") then
            WatchHarvestPrompt(plant, object)
        end
    end)

    task.spawn(function()
        plant.AncestryChanged:Wait()
        while plant.Parent do plant.AncestryChanged:Wait() end
        pcall(function() descendantConnection:Disconnect() end)
        HarvestWatchers[plant] = nil
    end)
end

local function StartInstantHarvestEngine()
    local plot = GetPlot()
    local plants = plot:WaitForChild("Plants")

    for _, plant in ipairs(plants:GetChildren()) do
        WatchHarvestPlant(plant)
    end

    plants.ChildAdded:Connect(function(plant)
        -- Watch ngay khi model vào Plants; watcher tự chờ attribute/prompt replicate.
        WatchHarvestPlant(plant)
    end)
end

local function SellAllNow()
    pcall(function()
        Net.NPCS.SellAll:Fire()
    end)
end

pcall(StartInstantHarvestEngine)

-- Sell là worker độc lập và đều nhịp: không phụ thuộc prompt có đổi Enabled hay không.
-- Cách này giải phóng crop liên tục khi harvest dồn dập, tránh Inventory Full khóa cả farm.
task.spawn(function()
    while task.wait(SELL_INTERVAL) do
        HarvestAttemptsSinceSell = 0
        SellAllNow()
    end
end)

-- ===================== BUY / EXPAND =====================
local function ParseSeedStockText(value)
    local text = tostring(value or ""):gsub("<.->", "")
    local amount = text:lower():match("x%s*(%d+)%s*in%s*stock")
    if amount then
        return tonumber(amount)
    end
    if text:lower():find("no%s*stock") then
        return 0
    end
    return nil
end

local function GetSeedStockFromUI(seedName)
    local playerGui = Player:FindFirstChild("PlayerGui")
    local seedShop = playerGui and playerGui:FindFirstChild("SeedShop")
    local frame = seedShop and seedShop:FindFirstChild("Frame")
    local normalShop = frame and frame:FindFirstChild("NormalShop")
    local row = normalShop and normalShop:FindFirstChild(seedName)
    if not row then return nil end

    local candidates = { row }
    for _, object in ipairs(row:GetDescendants()) do
        table.insert(candidates, object)
    end

    local sawNoStock = false
    for _, object in ipairs(candidates) do
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            local stock = ParseSeedStockText(object.Text)
            if stock ~= nil then
                if stock > 0 then
                    return stock
                end
                sawNoStock = true
            end
        end
    end
    return sawNoStock and 0 or nil
end

local function LooksLikeSeedShopState(value)
    if type(value) ~= "table" then return false end
    local carrot = rawget(value, "Carrot")
    local secondSeed = rawget(value, "Strawberry") or rawget(value, "Bamboo")
    return type(carrot) == "table"
        and (rawget(carrot, "maxStock") ~= nil or rawget(carrot, "frame") ~= nil)
        and type(secondSeed) == "table"
end

local function GetSeedShopStateTable()
    if LooksLikeSeedShopState(SeedShopStateTable) then
        return SeedShopStateTable
    end
    if type(getgc) ~= "function" then return nil end

    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then return nil end
    for _, value in ipairs(objects) do
        if LooksLikeSeedShopState(value) then
            SeedShopStateTable = value
            return value
        end
    end
    return nil
end

local function GetSeedStock(seedName)
    -- Nguồn chính: UI shop đã capture xác nhận có text "xN in Stock".
    local stock = GetSeedStockFromUI(seedName)
    if stock ~= nil then
        if DEBUG_SEED_STOCK then print("[SEED STOCK UI]", seedName, stock) end
        return math.max(0, math.floor(stock))
    end

    -- Fallback: bảng runtime capture được có entry[seedName].maxStock.
    local state = GetSeedShopStateTable()
    local entry = state and rawget(state, seedName)
    stock = type(entry) == "table" and tonumber(rawget(entry, "maxStock")) or nil
    if stock ~= nil then
        if DEBUG_SEED_STOCK then print("[SEED STOCK RUNTIME]", seedName, stock) end
        return math.max(0, math.floor(stock))
    end

    if DEBUG_SEED_STOCK then print("[SEED STOCK UNKNOWN]", seedName) end
    return nil
end

local function GetSeedRestockValue()
    local stockValues = ReplicatedStorage:FindFirstChild("StockValues")
    local seedShop = stockValues and stockValues:FindFirstChild("SeedShop")
    local lastRestock = seedShop and seedShop:FindFirstChild("UnixLastRestock")
    return lastRestock and tonumber(lastRestock.Value) or nil
end

local function RefreshSeedRestockState()
    local current = GetSeedRestockValue()
    if current and current ~= LastSeedRestockValue then
        LastSeedRestockValue = current
        -- Restock mới: cho phép retry ngay các seed đã fail ở restock cũ.
        SeedNextAttempt = {}
        SeedShopStateTable = nil
        SeedGlobalBackoffUntil = 0
    end
end

local function TryPurchaseOneSeed(seedName)
    while SeedPurchaseBusy do
        task.wait(0.02)
    end
    SeedPurchaseBusy = true

    -- Fail-closed: unknown stock or zero stock never sends a purchase request.
    local stock = GetSeedStock(seedName)
    if stock == nil or stock <= 0 then
        SeedPurchaseBusy = false
        return false, "no_stock"
    end

    local before = CountSeed(seedName)
    local purchasedBefore = CountPurchasedSeedThisRestock(seedName)
    local fired = pcall(function()
        Net.SeedShop.PurchaseSeed:Fire(seedName)
    end)

    local increased = false
    if fired then
        local started = tick()
        while tick() - started < SEED_BUY_CONFIRM_TIMEOUT do
            if CountSeed(seedName) > before
                or CountPurchasedSeedThisRestock(seedName) > purchasedBefore then
                increased = true
                break
            end
            task.wait(0.03)
        end
    end

    SeedPurchaseBusy = false
    return increased, increased and "purchased" or "purchase_failed"
end

local function BuySeedTowardTarget(seedName, targetAmount, maxAttempts)
    targetAmount = math.max(0, tonumber(targetAmount) or 0)
    if not AUTO_BUY_SEEDS or targetAmount <= 0 then return 0 end
    if tick() < SeedGlobalBackoffUntil then return 0 end
    if tick() < (SeedNextAttempt[seedName] or 0) then return 0 end
    local bufferRemaining = math.max(0, MAX_TOTAL_SEED_INVENTORY - CountAllSeeds())
    if bufferRemaining <= 0 then return 0 end

    local bought = 0
    local attempts = math.min(maxAttempts or 1, bufferRemaining, math.max(0, targetAmount - CountSeed(seedName)))
    for _ = 1, attempts do
        if CountAllSeeds() >= MAX_TOTAL_SEED_INVENTORY then break end
        if CountSeed(seedName) >= targetAmount then break end

        local stock = GetSeedStock(seedName)
        if stock == nil or stock <= 0 then break end

        local purchased, reason = TryPurchaseOneSeed(seedName)
        if purchased then
            bought += 1
        elseif reason == "purchase_failed" then
            -- Thường là thiếu tiền: ngừng toàn bộ buyer một nhịp, không spam từng seed.
            SeedGlobalBackoffUntil = tick() + 6
            SeedNextAttempt[seedName] = tick() + 6
            break
        else
            break
        end
    end
    return bought
end

local function GetConfiguredSeedOrder()
    local names = {}
    for seedName, targetAmount in pairs(SEED_BUY_TARGETS) do
        if (tonumber(targetAmount) or 0) > 0 then
            table.insert(names, seedName)
        end
    end

    table.sort(names, function(a, b)
        if a == b then return false end
        -- Seed hiếm/non-Carrot mua trước; Carrot chỉ lấp buffer còn lại.
        if a == "Carrot" then return false end
        if b == "Carrot" then return true end
        return a < b
    end)
    return names
end

local function RunSeedBuyerPass()
    if not AUTO_BUY_SEEDS then return end
    if tick() < SeedGlobalBackoffUntil then return end
    RefreshSeedRestockState()

    local remaining = SEED_BUY_MAX_PER_PASS
    for _, seedName in ipairs(GetConfiguredSeedOrder()) do
        if remaining <= 0 then break end
        local bufferRemaining = math.max(0, MAX_TOTAL_SEED_INVENTORY - CountAllSeeds())
        if bufferRemaining <= 0 then break end
        local target = tonumber(SEED_BUY_TARGETS[seedName]) or 0
        local need = math.max(0, target - CountSeed(seedName))
        local stock = GetSeedStock(seedName)
        if need > 0 and stock ~= nil and stock > 0 then
            local allowance = math.min(need, remaining, stock, bufferRemaining)
            local bought = BuySeedTowardTarget(seedName, target, allowance)
            remaining -= bought

            -- Một purchase fail không được phép chặn seed khác trong cùng pass.
            if bought == 0 and tick() < (SeedNextAttempt[seedName] or 0) then
                continue
            end
        end
    end
end

local function BuyCarrotAll()
    local target = math.max(1, tonumber(SEED_BUY_TARGETS.Carrot) or 1)
    return BuySeedTowardTarget("Carrot", target, BUY_MAX_ATTEMPTS) > 0
end

local function StartSeedShopBuyer()
    task.spawn(function()
        while task.wait(SEED_BUY_CHECK_INTERVAL) do
            pcall(RunSeedBuyerPass)
        end
    end)
end

