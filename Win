local function GetLocalReplica()
    if LocalReplica then return LocalReplica end

    local ok, PlotsController = pcall(function()
        return require(Controllers:WaitForChild("PlotsController"))
    end)
    if not ok then return nil end

    for _, up in ipairs(debug.getupvalues(PlotsController.Start)) do
        if type(up) == "table"
            and type(up.GetLocalReplica) == "function"
            and type(up.WaitForLocalReplica) == "function" then
            ReplicaController = up
            break
        end
    end

    if not ReplicaController then return nil end
    LocalReplica = ReplicaController:GetLocalReplica() or ReplicaController:WaitForLocalReplica()
    return LocalReplica
end

