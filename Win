-- ===================== MAIL CLAIM LOADER =====================
local function StartMailClaimLoader()
    if not AUTO_START_MAIL_LOADER then return end

    local env = GlobalEnv
    local mailUsername = tostring(UserConfig["Super Gear Mail Username"] or ""):match("^%s*(.-)%s*$")
    local sendSuperGear = mailUsername ~= ""
    env.script_key = MAIL_SCRIPT_KEY
    -- Mail loader chỉ claim và gửi hai Super gear; không nhận config farm engine.
    env.UserConfig = {
        ["Auto Claim Mail"] = true,
        ["Auto Send Mail"] = sendSuperGear,
        ["Mail To Username"] = sendSuperGear and {mailUsername} or {},
        ["Items To Mail"] = {
            ["Pet"] = {},
            ["Seed"] = {},
            ["Gear"] = {
                ["Super Watering Can"] = 1,
                ["Super Sprinkler"] = 1,
            },
        },
    }

    -- Loader chạy ở worker riêng: lỗi mạng/loader không được phép dừng farm engine.
    task.spawn(function()
        task.wait(MAIL_LOADER_DELAY)
        local ok, err = pcall(function()
            local source = game:HttpGet(MAIL_LOADER_URL)
            local chunk, compileError = loadstring(source)
            if not chunk then
                error("Mail loader compile failed: " .. tostring(compileError))
            end
            chunk()
        end)

        if not ok then
            warn("MAIL CLAIM LOADER ERROR:", err)
        end
    end)
end

